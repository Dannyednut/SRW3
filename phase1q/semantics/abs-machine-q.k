       <absjshadow> absStQ(1, true, true, succP(G0), succP(E0), N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, succP(G0), succP(E0), N, SF, D), aCommitJ(aOkF, aOkF)) </absjshadow>

  // the COMPLEMENT rule: fires only where no branch row matched (the
  // incoherent fragment — unreachable under ABSInvQ).  The 1P discipline.
  rule <k> AC:ACmd => .K ... </k>
       <absjshadow> AX:AStateQ => AX </absjshadow> [owise]

  // ===========================================================================
  // §E — THE CONJUNCTIVE TAGGED INVARIANT (EQ-C; the 1P form with the pool
  //      conjuncts re-encoded: the tag-0 pool tests become constructor
  //      equalities; the tag-1 pool conjuncts (G >=Int 0 andBool E >=Int 0)
  //      are REMOVED — structural nonnegativity is a theorem of the
  //      representation (C1), not invariant content; the meaning-
  //      preservation obligation is C4).  The shape is CONJUNCTIVE
  //      (impliesBool, never orBool at the top, never if-then-else).
  // ===========================================================================
  syntax Bool ::= ABSInvQ ( AStateQ ) [function, total]
  rule ABSInvQ(absStQ(TG:Int, C:Bool, T:Bool, G:PoolCount, E:PoolCount, N:Int, SF:Bool, _:ADiag))
    => TG >=Int 0 andBool TG <=Int 1
       andBool (TG ==Int 0 impliesBool (notBool C andBool notBool T
                    andBool isZeroP(G) andBool isZeroP(E) andBool N ==Int 0))
       andBool (TG ==Int 1 impliesBool (C andBool T andBool SF))

  syntax Bool ::= tagCoherentQ ( AStateQ ) [function, total]
  rule tagCoherentQ(absStQ(TG:Int, C:Bool, T:Bool, G:PoolCount, E:PoolCount, N:Int, _:Bool, _:ADiag))
    => (TG ==Int 0 impliesBool (notBool C andBool notBool T
             andBool isZeroP(G) andBool isZeroP(E) andBool N ==Int 0))
       andBool
       (TG ==Int 1 impliesBool (C andBool T))

  // ===========================================================================
  // §F — THE DOMAIN PREDICATE AND THE FOLD (EQ-F + the EQ-F′ fix of record:
  //      the 1P [owise] recursion's owise condition is a conjunction of
  //      negated constructor equalities WITH ARGUMENTS over the symbolic
  //      program — the pinned checker's decision procedure gives up on it
  //      (DecidePredicateUnknown, the first 1Q-UNIV-MACHINE-Q attempt,
  //      transcripts/k/kprove_1Q-UNIV-MACHINE-Q-attempt1.log).  EQ-F′
  //      replaces the [owise] with an EXPLICIT TOTAL CONSTRUCTOR COVER:
  //      one row per command constructor (+ the tag-0/tag-1 exec split),
  //      no requires, no [owise] — the same rewrite-level constructor
  //      matching as the runner fork.  DISCLOSED SEMANTIC BOUNDARY: on
  //      INCOHERENT states (tag outside {0,1}) the 1P predicate folded
  //      identity steps to true; the Q predicate is UNDEFINED there (no
  //      row).  The coherent fragment — the only fragment ABSInvQ admits —
  //      is unchanged, and the 1P evidence never used incoherent states.
  // ===========================================================================
  syntax Bool ::= absExecutableQ ( APProg , AStateQ ) [function, total]
  rule absExecutableQ(aRunNilJ, _:AStateQ) => true
  rule absExecutableQ(aConsJ(aExecJ(_:AOk, _:ASrc), _:APProg),
                      absStQ(0, _:Bool, _:Bool, _:PoolCount, _:PoolCount, _:Int, _:Bool, _:ADiag))
    => false
  rule absExecutableQ(aConsJ(aExecJ(A1:AOk, A2:ASrc), R:APProg),
                      absStQ(1, C:Bool, T:Bool, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag))
    => absExecutableQ(R, absStepQ(absStQ(1, C, T, G, E, N, SF, D), aExecJ(A1, A2)))
  rule absExecutableQ(aConsJ(aInitJ(A:AOk), R:APProg), AX:AStateQ)
    => absExecutableQ(R, absStepQ(AX, aInitJ(A)))
  rule absExecutableQ(aConsJ(aGateJ(A:AOk), R:APProg), AX:AStateQ)
    => absExecutableQ(R, absStepQ(AX, aGateJ(A)))
  rule absExecutableQ(aConsJ(aCommitJ(A1:AOk, A2:AOk), R:APProg), AX:AStateQ)
    => absExecutableQ(R, absStepQ(AX, aCommitJ(A1, A2)))

  syntax AStateQ ::= absRunFQ ( APProg , AStateQ ) [function, total]
  rule absRunFQ(aRunNilJ, AX:AStateQ) => AX
  rule absRunFQ(aConsJ(AC:ACmd, R:APProg), AX:AStateQ)
    => absRunFQ(R, absStepQ(AX, AC))

  // the initialized-shaped projection (the 1P STRENGTHENED form: the tag
  // conjunct carried)
  syntax Bool ::= absInitShapedQ ( AStateQ ) [function, total]
  rule absInitShapedQ(absStQ(TG:Int, C:Bool, T:Bool, _:PoolCount, _:PoolCount, _:Int, SF:Bool, _:ADiag))
    => TG ==Int 1 andBool C andBool T andBool SF

  // ===========================================================================
  // §G — THE REFINEMENT MAP (EQ-G; see spec/refinement-relation.md)
  //      absStQE is the ERASE-TARGET mirror sort, field-isomorphic to the
  //      1P AStateT minus the tag (the tag is branchTag(C,T)).  The 1P
  //      module cannot be imported without its runner rules (they would
  //      contaminate the Q machine's reachability), so the mirror is
  //      declared here; make_abs_q.py verifies the command-syntax
  //      correspondence against the 1P source at generation time.  The
  //      Int-image step absStepE is the 1P absStepT TDRR rows VERBATIM
  //      (renamed; the tag literals replaced by the bit literals they were
  //      pinned with).  The Int->PoolCount rebuild direction is deliberately
  //      NOT defined (it would need Int induction; no C obligation requires
  //      it — spec/refinement-relation.md §2).
  // ===========================================================================
  syntax AStateQE ::= absStQE ( cfgP:Bool
                              , catP:Bool
                              , cntG:Int
                              , cntE:Int
                              , nSlot:Int
                              , safe:Bool
                              , diag:ADiag )

  syntax Int ::= branchTag ( Bool , Bool ) [function, total]
  rule branchTag(true,  true)  => 1
  rule branchTag(false, false) => 0

  syntax Int ::= countToInt ( PoolCount ) [function, total]
  rule countToInt(zeroP) => 0
  rule countToInt(succP(N:PoolCount)) => countToInt(N) +Int 1

  syntax AStateQE ::= eraseQ ( AStateQ ) [function, total]
  rule eraseQ(absStQ(_:Int, C:Bool, T:Bool, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag))
    => absStQE(C, T, countToInt(G), countToInt(E), N, SF, D)

  // ---- the Int-image step (the 1P TDRR rows verbatim, renamed) -------------
  syntax AStateQE ::= absStepE ( AStateQE , ACmd ) [function, total]

  rule absStepE(absStQE(false, false, _:Int, _:Int, _:Int, _:Bool, D:ADiag),
                aInitJ(aOkT))
    => absStQE(true, true, 0, 0, 0, true, D)                  // THE re-tag (pools reset)
  rule absStepE(absStQE(false, false, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aInitJ(aOkF))
    => absStQE(false, false, G, E, N, SF, D)                  // refuse, tag kept
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aInitJ(_:AOk))
    => absStQE(true, true, G, E, N, SF, D)                    // re-init refused

  rule absStepE(absStQE(false, false, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aExecJ(_:AOk, _:ASrc))
    => absStQE(false, false, G, E, N, SF, D)                  // the stall (identity)
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aExecJ(aOkT, aSrcAuth))
    => absStQE(true, true, G, E +Int 1, N, SF, D)             // the mint class
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, _:ADiag),
                aExecJ(aOkT, aSrcOther))
    => absStQE(true, true, G, E, N, SF, adSource)             // J-A08 refusal
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, _:ADiag),
                aExecJ(aOkF, _:ASrc))
    => absStQE(true, true, G, E, N, SF, adExecRefuse)         // unsupported/bounds

  rule absStepE(absStQE(false, false, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aGateJ(_:AOk))
    => absStQE(false, false, G, E, N, SF, adGate)             // pre-init refusal
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, _:ADiag),
                aGateJ(_:AOk))
    => absStQE(true, true, G, E, N, SF, adGate)               // row A: empty pool
    requires E <=Int 0
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aGateJ(aOkT))
    => absStQE(true, true, G +Int 1, E, N, SF, D)             // row B: the mint class
    requires E >=Int 1
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, _:ADiag),
                aGateJ(aOkF))
    => absStQE(true, true, G, E, N, SF, adGate)               // row C: refused, nonempty
    requires E >=Int 1

  rule absStepE(absStQE(false, false, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aCommitJ(_:AOk, _:AOk))
    => absStQE(false, false, G, E, N, SF, D)                  // pre-init reject
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, _:Bool, D:ADiag),
                aCommitJ(aOkT, aOkT))
    => absStQE(true, true, G -Int 1, E -Int 1, N +Int 1, true, D)  // row B: accept
    requires G >=Int 1 andBool E >=Int 1
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aCommitJ(aOkT, aOkF))
    => absStQE(true, true, G, E, N, SF, D)                    // row C: reject, pools ok
    requires G >=Int 1 andBool E >=Int 1
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aCommitJ(aOkF, _:AOk))
    => absStQE(true, true, G, E, N, SF, D)                    // row D: reject, pools ok
    requires G >=Int 1 andBool E >=Int 1
  rule absStepE(absStQE(true, true, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aCommitJ(_:AOk, _:AOk))
    => absStQE(true, true, G, E, N, SF, D)                    // row A: the complement
    requires G <=Int 0 orBool E <=Int 0

  // the incoherent-bit complement on the mirror (the 1P tag complement's
  // image; branchTag is stuck on mixed bits, so the row is inert on the
  // coherent fragment — the same states are stuck on both sides)
  rule absStepE(absStQE(C:Bool, T:Bool, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                _:ACmd)
    => absStQE(C, T, G, E, N, SF, D)
    requires branchTag(C, T) >=Int 2 orBool branchTag(C, T) <=Int -1 [owise]

  // ---- the 1P invariant meaning on the mirror (the C4 subject) -------------
  syntax Bool ::= ABSInvE ( AStateQE ) [function, total]
  rule ABSInvE(absStQE(C:Bool, T:Bool, G:Int, E:Int, N:Int, SF:Bool, _:ADiag))
    => branchTag(C, T) >=Int 0 andBool branchTag(C, T) <=Int 1
       andBool (branchTag(C, T) ==Int 0 impliesBool (notBool C andBool notBool T
                    andBool G ==Int 0 andBool E ==Int 0 andBool N ==Int 0))
       andBool (branchTag(C, T) ==Int 1 impliesBool (C andBool T
                    andBool G >=Int 0 andBool E >=Int 0 andBool SF))

endmodule
