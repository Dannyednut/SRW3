requires "srw3closure-j-m4.k"

module SRW3N-ABS-Q
  imports SRW3CLOSURE-J-M4

  // ===========================================================================
  // §A — THE CONSTRUCTOR COUNT AND THE TAGGED STATE SPACE (EQ-A)
  // ===========================================================================
  syntax PoolCount ::= "zeroP" [constructor]          // exactly zero receipts
  syntax PoolCount ::= succP(PoolCount) [constructor] // exactly one more receipt than _

  syntax Bool ::= isZeroP ( PoolCount ) [function, total]
  rule isZeroP(zeroP) => true
  rule isZeroP(succP(_:PoolCount)) => false
  syntax Bool ::= isSuccP ( PoolCount ) [function, total]
  rule isSuccP(zeroP) => false
  rule isSuccP(succP(_:PoolCount)) => true

  syntax ADiag ::= "adNone"        // jrefuseNoneJ
                 | "adSource"      // jrefusedSource()
                 | "adExecRefuse"  // jrefusedUnsupported(_) | jrefusedBounds(_)
                 | "adGate"        // jrefusedGate()

  syntax AStateQ ::= absStQ ( tg:Int         // THE BRANCH TAG: 0 = pre-init,
                              , cfgP:Bool    //                   1 = initialized
                              , catP:Bool
                              , cntG:PoolCount
                              , cntE:PoolCount
                              , nSlot:Int
                              , safe:Bool
                              , diag:ADiag )

  syntax AStateQ ::= "absGenesisQ" [function, total]
  rule absGenesisQ => absStQ( 0, false, false, zeroP, zeroP, 0, false, adNone )

  syntax Int ::= absTagOfQ ( AStateQ ) [function, total]
  rule absTagOfQ(absStQ(TG:Int, _:Bool, _:Bool, _:PoolCount, _:PoolCount, _:Int, _:Bool, _:ADiag)) => TG
  syntax Bool ::= absCfgPinnedQ ( AStateQ ) [function, total]
  rule absCfgPinnedQ(absStQ(_:Int, C:Bool, _:Bool, _:PoolCount, _:PoolCount, _:Int, _:Bool, _:ADiag)) => C:Bool
  syntax Bool ::= absCatPinnedQ ( AStateQ ) [function, total]
  rule absCatPinnedQ(absStQ(_:Int, _:Bool, T:Bool, _:PoolCount, _:PoolCount, _:Int, _:Bool, _:ADiag)) => T:Bool
  syntax Bool ::= absSafeQ ( AStateQ ) [function, total]
  rule absSafeQ(absStQ(_:Int, _:Bool, _:Bool, _:PoolCount, _:PoolCount, _:Int, SF:Bool, _:ADiag)) => SF:Bool

  // ===========================================================================
  // §B — THE COMMAND LANGUAGE (EQ-B: the 1P syntax VERBATIM, byte-checked)
  // ===========================================================================
  syntax AOk ::= "aOkT" | "aOkF"
  syntax ASrc ::= "aSrcAuth"    // SRC == qcrExecClientDOf(C)  (J-A08)
                | "aSrcOther"   // the unauthorized-source class

  syntax ACmd ::= aInitJ ( AOk )                 // the FULL init-guard outcome
                | aExecJ ( AOk , ASrc )          // (fragment-ok, source class)
                | aGateJ ( AOk )                 // the FULL gate-mint-precondition outcome
                | aCommitJ ( AOk , AOk )         // (accept-guard, computed SafeJ on derived post)
  syntax APProg ::= "aRunNilJ" | aConsJ ( ACmd , APProg )

  // ===========================================================================
  // §C — THE CONSTRUCTOR-COUNT STEP (EQ-D: the twelve-class mirror; the
  //      Int-guarded classes become CONSTRUCTOR PATTERN splits; NO requires
  //      on any pool — the ONLY requires is the carried incoherent-tag
  //      complement.  THE INIT-ACCEPT IS THE ONLY LEGAL RE-TAG (0 -> 1).
  //      The structural dec (strip succP) appears ONLY in the commit-accept
  //      row; zeroP has NO decrement anywhere.)
  // ===========================================================================
  syntax AStateQ ::= absStepQ ( AStateQ , ACmd ) [function, total]

  // ---- init (rows 1-3) ------------------------------------------------------
  rule absStepQ(absStQ(0, false, false, _:PoolCount, _:PoolCount, _:Int, _:Bool, D:ADiag),
                aInitJ(aOkT))
    => absStQ(1, true, true, zeroP, zeroP, 0, true, D)        // THE re-tag 0->1 (pools reset)
  rule absStepQ(absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag),
                aInitJ(aOkF))
    => absStQ(0, false, false, G, E, N, SF, D)                // refuse, tag kept
  rule absStepQ(absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag),
                aInitJ(_:AOk))
    => absStQ(1, true, true, G, E, N, SF, D)                  // re-init refused

  // ---- exec (rows 4, 7-9) ---------------------------------------------------
  rule absStepQ(absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag),
                aExecJ(_:AOk, _:ASrc))
    => absStQ(0, false, false, G, E, N, SF, D)                // the stall (identity)
  rule absStepQ(absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag),
                aExecJ(aOkT, aSrcAuth))
    => absStQ(1, true, true, G, succP(E), N, SF, D)           // the mint class (structural inc)
  rule absStepQ(absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, _:ADiag),
                aExecJ(aOkT, aSrcOther))
    => absStQ(1, true, true, G, E, N, SF, adSource)           // J-A08 refusal
  rule absStepQ(absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, _:ADiag),
                aExecJ(aOkF, _:ASrc))
    => absStQ(1, true, true, G, E, N, SF, adExecRefuse)       // unsupported/bounds

  // ---- gate (rows 5, 10) — THE CONSTRUCTOR SPLIT (complete: the
  //      (bit x pool-head) grid is covered — row A-Z: any bit, empty pool;
  //      row B-S: aOkT, successor head; row C-S: aOkF, successor head.
  //      NO requires.  The 1P-F1 lesson mechanized: the generator checks
  //      every cell below.) --------------------------------------------------
  rule absStepQ(absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag),
                aGateJ(_:AOk))
    => absStQ(0, false, false, G, E, N, SF, adGate)           // pre-init refusal
  rule absStepQ(absStQ(1, true, true, G:PoolCount, zeroP, N:Int, SF:Bool, _:ADiag),
                aGateJ(_:AOk))
    => absStQ(1, true, true, G, zeroP, N, SF, adGate)         // row A-Z: empty pool
  rule absStepQ(absStQ(1, true, true, G:PoolCount, succP(E0), N:Int, SF:Bool, D:ADiag),
                aGateJ(aOkT))
    => absStQ(1, true, true, succP(G), succP(E0), N, SF, D)   // row B-S: the mint class (structural inc on G; E KEPT — the 1P row increments G and leaves E)
  rule absStepQ(absStQ(1, true, true, G:PoolCount, succP(E0), N:Int, SF:Bool, _:ADiag),
                aGateJ(aOkF))
    => absStQ(1, true, true, G, succP(E0), N, SF, adGate)     // row C-S: refused, nonempty

  // ---- commit (rows 6, 11-12) — THE CONSTRUCTOR SPLIT -----------------------
  //      Acceptance STRUCTURALLY requires both pools to have a successor
  //      constructor (row B-SS).  Rejection covers every zero-valued pool
  //      (rows A-Z*, A-SZ) and every rejected command-bit combination over
  //      nonempty pools (rows C-SS, D-SS).  NO requires.
  rule absStepQ(absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag),
                aCommitJ(_:AOk, _:AOk))
    => absStQ(0, false, false, G, E, N, SF, D)                // pre-init reject
  rule absStepQ(absStQ(1, true, true, succP(G0), succP(E0), N:Int, _:Bool, D:ADiag),
                aCommitJ(aOkT, aOkT))
    => absStQ(1, true, true, G0, E0, N +Int 1, true, D)       // row B-SS: accept (structural dec x2)
  rule absStepQ(absStQ(1, true, true, succP(G0), succP(E0), N:Int, SF:Bool, D:ADiag),
                aCommitJ(aOkT, aOkF))
    => absStQ(1, true, true, succP(G0), succP(E0), N, SF, D)   // row C-SS: reject, pools ok (identity)
  rule absStepQ(absStQ(1, true, true, succP(G0), succP(E0), N:Int, SF:Bool, D:ADiag),
                aCommitJ(aOkF, _:AOk))
    => absStQ(1, true, true, succP(G0), succP(E0), N, SF, D)   // row D-SS: reject, pools ok (identity)
  rule absStepQ(absStQ(1, true, true, zeroP, E:PoolCount, N:Int, SF:Bool, D:ADiag),
                aCommitJ(_:AOk, _:AOk))
    => absStQ(1, true, true, zeroP, E, N, SF, D)              // row A-Z*: the G-empty complement
  rule absStepQ(absStQ(1, true, true, succP(G0), zeroP, N:Int, SF:Bool, D:ADiag),
                aCommitJ(_:AOk, _:AOk))
    => absStQ(1, true, true, succP(G0), zeroP, N, SF, D)       // row A-SZ: the E-empty complement (G nonempty)

  // ---- the INCOHERENT-TAG complement (totality; inert on the reachable
  //      fragment — the COH family proves the step keeps coherent states
  //      coherent, and the genesis is coherent, so no reachable state has a
  //      tag outside {{0,1}}) --------------------------------------------------
  rule absStepQ(absStQ(TG:Int, C:Bool, T:Bool, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag),
                _:ACmd)
    => absStQ(TG, C, T, G, E, N, SF, D)
    requires TG >=Int 2 orBool TG <=Int -1 [owise]

  // ===========================================================================
  // §D — THE RUNNER (EQ-E: the TDRR branch-discriminated ground-command rows
  //      + THE CONSTRUCTOR FORK).  Each ground-command rule patterns the
  //      shadow's BRANCH (tag-0 rows match absStQ(0, false, false, ...);
  //      tag-1 rows match absStQ(1, true, true, ...)) — the tag
  //      discrimination at the rewrite level (the proven TD mechanism).
  //      EVERY tag-1 gate/commit ground shape is FORKED ON THE POOL-HEAD
  //      CONSTRUCTORS in the <absjshadow> cell — a REWRITE position, the
  //      position 1O/1P proved the checker discriminates.  The fork is
  //      exhaustive by free-constructor totality ({zeroP, succP} per pool)
  //      and carries NO requires: after a fork row matches, the term handed
  //      to absStepQ has CONCRETE constructor heads at exactly the positions
  //      the step rows discriminate — function evaluation is direct
  //      matching.  (The TDRR unforked tag-1 commit rows have NO Q
  //      counterpart: they existed because the TDRR fork carried requires;
  //      the Q fork does not.  Disclosed, EQ-E.)  The stall discipline is
  //      unchanged: NO exec rule on the tag-0 shadow.
  // ===========================================================================
  rule <k> aConsJ(AC:ACmd, R:APProg) => AC ~> R ... </k>
  rule <k> aRunNilJ => .K ... </k>

  // ---- the tag-0 (pre-init) rows -------------------------------------------
  rule <k> aInitJ(aOkT) => .K ... </k>
       <absjshadow> absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(0, false, false, G, E, N, SF, D), aInitJ(aOkT)) </absjshadow>
  rule <k> aInitJ(aOkF) => .K ... </k>
       <absjshadow> absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(0, false, false, G, E, N, SF, D), aInitJ(aOkF)) </absjshadow>
  rule <k> aGateJ(aOkT) => .K ... </k>
       <absjshadow> absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(0, false, false, G, E, N, SF, D), aGateJ(aOkT)) </absjshadow>
  rule <k> aGateJ(aOkF) => .K ... </k>
       <absjshadow> absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(0, false, false, G, E, N, SF, D), aGateJ(aOkF)) </absjshadow>
  rule <k> aCommitJ(aOkT, aOkT) => .K ... </k>
       <absjshadow> absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(0, false, false, G, E, N, SF, D), aCommitJ(aOkT, aOkT)) </absjshadow>
  rule <k> aCommitJ(aOkT, aOkF) => .K ... </k>
       <absjshadow> absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(0, false, false, G, E, N, SF, D), aCommitJ(aOkT, aOkF)) </absjshadow>
  rule <k> aCommitJ(aOkF, aOkT) => .K ... </k>
       <absjshadow> absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(0, false, false, G, E, N, SF, D), aCommitJ(aOkF, aOkT)) </absjshadow>
  rule <k> aCommitJ(aOkF, aOkF) => .K ... </k>
       <absjshadow> absStQ(0, false, false, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(0, false, false, G, E, N, SF, D), aCommitJ(aOkF, aOkF)) </absjshadow>
  // NO tag-0 exec rule (the stall discipline — the concrete mirror).

  // ---- the tag-1 (initialized) rows: the non-discriminating commands ------
  rule <k> aInitJ(aOkT) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, E, N, SF, D), aInitJ(aOkT)) </absjshadow>
  rule <k> aInitJ(aOkF) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, E, N, SF, D), aInitJ(aOkF)) </absjshadow>
  rule <k> aExecJ(aOkT, aSrcAuth) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, E, N, SF, D), aExecJ(aOkT, aSrcAuth)) </absjshadow>
  rule <k> aExecJ(aOkT, aSrcOther) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, E, N, SF, D), aExecJ(aOkT, aSrcOther)) </absjshadow>
  rule <k> aExecJ(aOkF, aSrcAuth) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, E, N, SF, D), aExecJ(aOkF, aSrcAuth)) </absjshadow>
  rule <k> aExecJ(aOkF, aSrcOther) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, E:PoolCount, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, E, N, SF, D), aExecJ(aOkF, aSrcOther)) </absjshadow>

  // ---- THE CONSTRUCTOR FORK: every tag-1 gate/commit ground shape forks on
  //      the pool-head constructors (NO requires; exhaustive by free-
  //      constructor totality) ------------------------------------------------
  // gate, aOkT: E = zeroP | succP(E0)
  rule <k> aGateJ(aOkT) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, zeroP, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, zeroP, N, SF, D), aGateJ(aOkT)) </absjshadow>
  rule <k> aGateJ(aOkT) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, succP(E0), N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, succP(E0), N, SF, D), aGateJ(aOkT)) </absjshadow>
  // gate, aOkF: E = zeroP | succP(E0)
  rule <k> aGateJ(aOkF) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, zeroP, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, zeroP, N, SF, D), aGateJ(aOkF)) </absjshadow>
  rule <k> aGateJ(aOkF) => .K ... </k>
       <absjshadow> absStQ(1, true, true, G:PoolCount, succP(E0), N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, G, succP(E0), N, SF, D), aGateJ(aOkF)) </absjshadow>
  // commit, (aOkT,aOkT): (G,E) in {zeroP,succP}^2
  rule <k> aCommitJ(aOkT, aOkT) => .K ... </k>
       <absjshadow> absStQ(1, true, true, zeroP, zeroP, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, zeroP, zeroP, N, SF, D), aCommitJ(aOkT, aOkT)) </absjshadow>
  rule <k> aCommitJ(aOkT, aOkT) => .K ... </k>
       <absjshadow> absStQ(1, true, true, zeroP, succP(E0), N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, zeroP, succP(E0), N, SF, D), aCommitJ(aOkT, aOkT)) </absjshadow>
  rule <k> aCommitJ(aOkT, aOkT) => .K ... </k>
       <absjshadow> absStQ(1, true, true, succP(G0), zeroP, N:Int, SF:Bool, D:ADiag)
                 => absStepQ(absStQ(1, true, true, succP(G0), zeroP, N, SF, D), aCommitJ(aOkT, aOkT)) </absjshadow>
  rule <k> aCommitJ(aOkT, aOkT) => .K ... </k>
       <absjshadow> absStQ(1, true, true, succP(G0), succP(E0), N:Int, SF:Bool, D:ADiag)
