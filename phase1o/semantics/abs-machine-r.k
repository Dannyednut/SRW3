// =============================================================================
// SRW3 PHASE 1O — THE REWRITE-DISPATCHED ABSTRACT MACHINE (R-variant)
//                    (phase1o/semantics/abs-machine-r.k)
//
// GENERATED by phase1o/scripts/make_abs_r.py from phase1n/semantics/
// abs-machine.k.  DO NOT EDIT BY HAND.  The ONLY rule difference is the
// disclosed rewrite-level command dispatch (12 ground-command runner
// rules replacing the 4 symbolic-bit rules); the module is renamed
// SRW3N-ABS-R.  absStepJ, ABSInv, simJ, absExecutable, absRunF are
// UNCHANGED.  Level III only; no consensus-integration claim.
// =============================================================================

requires "srw3closure-j-m4.k"

module SRW3N-ABS-R
  imports SRW3CLOSURE-J-M4

  // ===========================================================================
  // §A — THE ABSTRACT STATE SPACE
  // ===========================================================================
  syntax ADiag ::= "adNone"        // jrefuseNoneJ
                 | "adSource"      // jrefusedSource()
                 | "adExecRefuse"  // jrefusedUnsupported(_) | jrefusedBounds(_)
                 | "adGate"        // jrefusedGate()

  syntax AState ::= absSt ( cfgP:Bool     // cfgPinnedJ(<jlineage>)
                          , catP:Bool     // catPinnedJ(<jlineage>)
                          , cntG:Int      // | gate-receipt pool (-2) |
                          , cntE:Int      // | exec-receipt pool (-4) |
                          , nSlot:Int     // <jnext>
                          , safe:Bool     // the state-safety bookkeeping bit
                          , diag:ADiag )  // the diagnostic class

  // the genesis abstract state (the M4 configuration's shadow start value
  // is supplied by the caller; the abstract ladder pins this shape)
  syntax AState ::= "absGenesis" [function, total]
  rule absGenesis => absSt( false, false, 0, 0, 0, false, adNone )

  syntax Bool ::= absCfgPinnedOf ( AState ) [function, total]
  rule absCfgPinnedOf(absSt(C:Bool, _:Bool, _:Int, _:Int, _:Int, _:Bool, _:ADiag)) => C:Bool
  syntax Bool ::= absCatPinnedOf ( AState ) [function, total]
  rule absCatPinnedOf(absSt(_:Bool, T:Bool, _:Int, _:Int, _:Int, _:Bool, _:ADiag)) => T:Bool
  syntax Bool ::= absSafeOf ( AState ) [function, total]
  rule absSafeOf(absSt(_:Bool, _:Bool, _:Int, _:Int, _:Int, SF:Bool, _:ADiag)) => SF:Bool

  // ===========================================================================
  // §B — THE ABSTRACT COMMAND LANGUAGE
  //     aOkT/aOkF: the OUTCOME of the corresponding concrete guard class,
  //     declared on the command and AGREED by the SIM claims (the concrete
  //     rule's own requires is the witness — never assumed abstractly).
  // ===========================================================================
  syntax AOk ::= "aOkT" | "aOkF"
  syntax ASrc ::= "aSrcAuth"    // SRC == qcrExecClientDOf(C)  (J-A08)
                | "aSrcOther"   // the unauthorized-source class

  syntax ACmd ::= aInitJ ( AOk )                 // the FULL init-guard outcome
                | aExecJ ( AOk , ASrc )          // (fragment-ok, source class)
                | aGateJ ( AOk )                 // the FULL gate-mint-precondition outcome
                | aCommitJ ( AOk , AOk )         // (accept-guard, computed SafeJ on derived post)
  syntax APProg ::= "aRunNilJ" | aConsJ ( ACmd , APProg )

  // ===========================================================================
  // §C — THE ABSTRACT STEP (the mirror of the M3 transition partition)
  //      absStepJ is the SINGLE definition of the abstract dynamics; the
  //      machine rules below merely wire it to the shadow cell, so the ABS
  //      ladder, the algebra claims, and every krun share one semantics.
  // ===========================================================================
  syntax AState ::= absStepJ ( AState , ACmd ) [function, total]

  // ---- init: accept ONLY from the unpinned state with the safe bit (the
  //      concrete accept requires the authorized root, the WF catalog, the
  //      digest bindings, and SafeJ(P, .Map) — ALL collapsed into the bit,
  //      agreed by SIM-INIT-ACCEPT); everything else refuses unchanged.
  rule absStepJ(absSt(false, false, _:Int, _:Int, _:Int, _:Bool, D:ADiag),
                aInitJ(aOkT))
    => absSt(true, true, 0, 0, 0, true, D)
  rule absStepJ(absSt(C:Bool, T:Bool, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aInitJ(_:AOk))
    => absSt(C, T, G, E, N, SF, D) [owise]

  // ---- exec: the concrete dispatch requires cfgPinnedJ andBool catPinnedJ;
  //      the UNPINNED class is the declared STALL (no concrete rule exists;
  //      the abstract machine rule below does not fire either).  On the
  //      FUNCTION, the stall class is the identity (the declared convention;
  //      the machine-level rule never calls the function there).
  rule absStepJ(absSt(true, true, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aExecJ(aOkT, aSrcAuth))
    => absSt(true, true, G, E +Int 1, N, SF, D)          // the mint class
  rule absStepJ(absSt(true, true, G:Int, E:Int, N:Int, SF:Bool, _:ADiag),
                aExecJ(aOkT, aSrcOther))
    => absSt(true, true, G, E, N, SF, adSource)          // J-A08 refusal
  rule absStepJ(absSt(true, true, G:Int, E:Int, N:Int, SF:Bool, _:ADiag),
                aExecJ(aOkF, _:ASrc))
    => absSt(true, true, G, E, N, SF, adExecRefuse)      // unsupported/bounds
  rule absStepJ(absSt(C:Bool, T:Bool, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aExecJ(_:AOk, _:ASrc))
    => absSt(C, T, G, E, N, SF, D) [owise]               // the stall class (identity)

  // ---- gate: the mint class mirrors the concrete LHS (the exec-receipt
  //      pool NONEMPTY — SetItem(E) ES) + the collapsed input/authority/
  //      position/correspondence guard outcome (the bit); everything else
  //      is the explicit [owise] refusal (jrefusedGate — the M3 Workstream-C
  //      transition), which writes ONLY the diagnostic class.
  rule absStepJ(absSt(true, true, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aGateJ(aOkT))
    => absSt(true, true, G +Int 1, E, N, SF, D)
    requires E >=Int 1
  rule absStepJ(absSt(C:Bool, T:Bool, G:Int, E:Int, N:Int, SF:Bool, _:ADiag),
                aGateJ(_:AOk))
    => absSt(C, T, G, E, N, SF, adGate) [owise]

  // ---- commit: the accept class mirrors the concrete LHS (BOTH pools
  //      nonempty — SetItem(R) RS and SetItem(jgExecOf(R)) ES) + the
  //      collapsed accept-guard outcome + the COMPUTED SafeJ-on-derived-
  //      post outcome (the second bit — computed by the concrete guard,
  //      never assumed); the reject class ([owise]) changes NOTHING (the
  //      concrete reject writes no diagnostic and consumes no receipt).
  rule absStepJ(absSt(true, true, G:Int, E:Int, N:Int, _:Bool, D:ADiag),
                aCommitJ(aOkT, aOkT))
    => absSt(true, true, G -Int 1, E -Int 1, N +Int 1, true, D)
    requires G >=Int 1 andBool E >=Int 1
  rule absStepJ(absSt(C:Bool, T:Bool, G:Int, E:Int, N:Int, SF:Bool, D:ADiag),
                aCommitJ(_:AOk, _:AOk))
    => absSt(C, T, G, E, N, SF, D) [owise]
  // NOTE: deliberately NO global [owise] catch-all here.  absStepJ's
  // totality rests on the exhaustive per-class coverage above (every ACmd
  // constructor x every bit constructor is matched exactly once).  A global
  // catch-all would reduce a SYMBOLIC-command step to the identity and let
  // composition claims close vacuously (the unsound-shortcut hazard; the
  // audit's negative controls depend on this absence).

  // ---- the abstract runner (the <absjshadow> machine) -------------------
  // PHASE 1O DISCLOSED R EDIT (the ONLY SRW3N-ABS -> SRW3N-ABS-R rule
  // difference): the command dispatch is lifted to the REWRITE level —
  // ONE rule per GROUND command shape (12 = 2 init + 4 exec + 2 gate +
  // 4 commit), each consuming the literal command and updating the shadow
  // through absStepJ with the LITERAL command.  The 1N rules dispatched
  // through absStepJ with SYMBOLIC bit variables, which kprove cannot
  // case-split in function-argument position (the R10 evidence) — the R
  // shape is the R2/R6-proven rewrite-dispatched form.  The cons rule is
  // unchanged; the stall discipline is unchanged (NO exec rule on an
  // unpinned shadow — the exec-on-unpinned ground shapes have no rule).
  rule <k> aConsJ(AC:ACmd, R:APProg) => AC ~> R ... </k>
  rule <k> aRunNilJ => .K ... </k>

  rule <k> aInitJ(aOkT) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aInitJ(aOkT)) </absjshadow>
  rule <k> aInitJ(aOkF) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aInitJ(aOkF)) </absjshadow>

  rule <k> aExecJ(aOkT, aSrcAuth) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aExecJ(aOkT, aSrcAuth)) </absjshadow>
    requires absCfgPinnedOf(AX) andBool absCatPinnedOf(AX)
  rule <k> aExecJ(aOkT, aSrcOther) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aExecJ(aOkT, aSrcOther)) </absjshadow>
    requires absCfgPinnedOf(AX) andBool absCatPinnedOf(AX)
  rule <k> aExecJ(aOkF, aSrcAuth) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aExecJ(aOkF, aSrcAuth)) </absjshadow>
    requires absCfgPinnedOf(AX) andBool absCatPinnedOf(AX)
  rule <k> aExecJ(aOkF, aSrcOther) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aExecJ(aOkF, aSrcOther)) </absjshadow>
    requires absCfgPinnedOf(AX) andBool absCatPinnedOf(AX)
  // NO rule for aExecJ on an unpinned shadow (all four ground exec shapes):
  // the declared stall class, mirroring the concrete machine unchanged.

  rule <k> aGateJ(aOkT) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aGateJ(aOkT)) </absjshadow>
  rule <k> aGateJ(aOkF) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aGateJ(aOkF)) </absjshadow>

  rule <k> aCommitJ(aOkT, aOkT) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aCommitJ(aOkT, aOkT)) </absjshadow>
  rule <k> aCommitJ(aOkT, aOkF) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aCommitJ(aOkT, aOkF)) </absjshadow>
  rule <k> aCommitJ(aOkF, aOkT) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aCommitJ(aOkF, aOkT)) </absjshadow>
  rule <k> aCommitJ(aOkF, aOkF) => .K ... </k>
       <absjshadow> AX:AState => absStepJ(AX, aCommitJ(aOkF, aOkF)) </absjshadow>

  // the COMPLEMENT rule (exhaustiveness-by-construction): the 12 ground
  // shapes above ARE the whole of ACmd's ground terms, so this rule can
  // NEVER fire on a ground command (rule priority).  It exists so the
  // prover's complement branch (a command matching no ground shape —
  // satisfiable only for non-ground terms) closes: the command is
  // consumed and NOTHING changes (a non-committing stutter — the same
  // content as the 1N function-level identity convention; the exec-on-
  // unpinned stall also lands here, consuming the command and writing
  // nothing, which mirrors the concrete machine's SAFETY content: the
  // stuck concrete configuration writes nothing and commits nothing).
  // The soundness controls (the weak-machine universal MUST FAIL; the
  // destination control MUST FAIL) guard this rule against misuse.
  rule <k> AC:ACmd => .K ... </k>
       <absjshadow> AX:AState => AX </absjshadow> [owise]

  // ===========================================================================
  // §D — THE ABSTRACT INVARIANT (the decidable JInvPlusJ counterpart)
  //      pre-init branch: nothing pinned, empty pools, slot 0 (the
  //      diagnostic class is deliberately UNconstrained — the concrete
  //      pre-init gate/commit refusals write diagnostics while leaving
  //      every invariant cell unchanged);
  //      initialized branch: both pins, non-negative pool cardinalities,
  //      and the state-safety bookkeeping (established by the init guard's
  //      COMPUTED SafeJ(P, .Map); carried by the accept-commit's COMPUTED
  //      SafeJ-on-derived-post bit).
  // ===========================================================================
  syntax Bool ::= ABSInv ( AState ) [function, total]
  rule ABSInv(absSt(C:Bool, T:Bool, G:Int, E:Int, N:Int, SF:Bool, _:ADiag))
    => ( notBool C andBool notBool T
         andBool G ==Int 0 andBool E ==Int 0 andBool N ==Int 0 )
       orBool
       ( C andBool T andBool G >=Int 0 andBool E >=Int 0 andBool SF )

  // ===========================================================================
  // §E — THE SIMULATION PROJECTION AND THE RESPONDED-COMMAND DOMAIN
  //      simJ: the concrete cell projections -> AState.  The safe bit is
  //      FALSE by construction: it is the STRUCTURAL projection; the safety
  //      bookkeeping is carried by ABSInv + the command bits (the declared
  //      boundary — SafeJ over symbolic concrete maps is the 1L stuck class
  //      and is never evaluated here).
  // ===========================================================================
  syntax AState ::= simJ ( Bool , Bool , Int , Int , Int , JRefuse )
                    /* cfgP, catP, |gatePool|, |execPool|, slot, <jrefuse> */
                    [function, total]
  rule simJ(C:Bool, T:Bool, G:Int, E:Int, N:Int, jrefuseNoneJ)
    => absSt(C, T, G, E, N, false, adNone)
  rule simJ(C:Bool, T:Bool, G:Int, E:Int, N:Int, jrefusedSource())
    => absSt(C, T, G, E, N, false, adSource)
  rule simJ(C:Bool, T:Bool, G:Int, E:Int, N:Int, jrefusedUnsupported(_:Int))
    => absSt(C, T, G, E, N, false, adExecRefuse)
  rule simJ(C:Bool, T:Bool, G:Int, E:Int, N:Int, jrefusedBounds(_:Int))
    => absSt(C, T, G, E, N, false, adExecRefuse)
  rule simJ(C:Bool, T:Bool, G:Int, E:Int, N:Int, jrefusedGate())
    => absSt(C, T, G, E, N, false, adGate)

  // the declared responded-command fragment: absExecutable(RUN, AX) holds
  // iff EVERY command of RUN is responded to by the abstract machine from
  // the state reached so far.  The ONE non-responded class: aExecJ on an
  // unpinned shadow (the concrete pExecJ dispatch requires the pins; the
  // M3 machine has no pExecJ rule there — the honest stall, mirrored).
  syntax Bool ::= absExecutable ( APProg , AState ) [function, total]
  rule absExecutable(aRunNilJ, _:AState) => true
  rule absExecutable(aConsJ(aExecJ(_:AOk, _:ASrc), _:APProg),
                     absSt(false, _:Bool, _:Int, _:Int, _:Int, _:Bool, _:ADiag))
    => false
  rule absExecutable(aConsJ(AC:ACmd, R:APProg), AX:AState)
    => absExecutable(R, absStepJ(AX, AC)) [owise]

  // the abstract run fold (the universal theorem's carrier): the state
  // reached by executing RUN from AX through absStepJ.  The recursion
  // mirrors absExecutable's recursion EXACTLY, so the circular universal
  // proof's tail obligations align conjunct-by-conjunct.
  syntax AState ::= absRunF ( APProg , AState ) [function, total]
  rule absRunF(aRunNilJ, AX:AState) => AX
  rule absRunF(aConsJ(AC:ACmd, R:APProg), AX:AState)
    => absRunF(R, absStepJ(AX, AC))

  // the STRUCTURAL projection of an abstract state: the safe bookkeeping
  // component is deliberately cleared.  simJ cannot READ the concrete
  // safe bit (SafeJ over symbolic concrete maps is the 1L stuck class —
  // the declared boundary), so the simulation algebra is stated as
  // simJ(post) == absStructOf(absStepJ(simJ(pre), cmd)) — the structural
  // agreement — while the SAFE component's agreement is carried by the
  // command-bit witnesses (the concrete guards) in the SIM shape claims.
  syntax AState ::= absStructOf ( AState ) [function, total]
  rule absStructOf(absSt(C:Bool, T:Bool, G:Int, E:Int, N:Int, _:Bool, D:ADiag))
    => absSt(C, T, G, E, N, false, D)

  // the initialized-shaped projection (the committed-prefix corollary's
  // conclusion): the run ENDS in the initialized branch with the safety
  // bookkeeping held.
  syntax Bool ::= absInitShaped ( AState ) [function, total]
  rule absInitShaped(absSt(C:Bool, T:Bool, _:Int, _:Int, _:Int, SF:Bool, _:ADiag))
    => C andBool T andBool SF

endmodule
