  // ===========================================================================
  // 1O-UNIV-MACHINE-RL — the machine-form universal over the R machine,
  //     with the branch-complete preservation family above as [lemma]
  //     axioms.  The per-step content comes from the lemmas (each
  //     independently proven); the composition comes from the
  //     circularity; the [owise] complement rule closes the prover's
  //     spurious complement branch.  The soundness controls: the
  //     weak-machine universal (n_o_univ_weak_r.k) MUST FAIL and the
  //     destination control MUST FAIL.
  // ===========================================================================
  claim
    <srw3closureJ>
      <k> RUN:APProg => .K ... </k>
      <absjshadow> AX:AState => ?AX2:AState </absjshadow>
      ...
    </srw3closureJ>
    requires ABSInv(AX) andBool absExecutable(RUN:APProg, AX:AState)
    ensures ABSInv(?AX2:AState)
    [circularity, label(1O-UNIV-MACHINE-RL)]

  claim
    <srw3closureJ>
      <k> RUN:APProg => .K ... </k>
      <absjshadow> AX:AState => ?AX2:AState </absjshadow>
      ...
    </srw3closureJ>
    requires ABSInv(AX) andBool absCfgPinnedOf(AX)
         andBool absExecutable(RUN:APProg, AX:AState)
    ensures absInitShaped(?AX2:AState)
    [circularity, label(1O-UNIV-PREFIX-RL)]

  claim
    <srw3closureJ>
      <k> RUN:APProg => .K ... </k>
      <absjshadow> AX:AState => ?AX2:AState </absjshadow>
      ...
    </srw3closureJ>
    requires ABSInv(AX) andBool absExecutable(RUN:APProg, AX:AState)
    ensures ?AX2:AState ==K absGenesis
    [label(1O-NEG-DEST-RL)]

