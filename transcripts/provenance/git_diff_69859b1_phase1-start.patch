@@ -0,0 +1,205 @@
+// =============================================================================
+// proofs/defects/phantom_reject.k
+//
+// PRIORITY-3 AUDIT ARTIFACT — the "phantom reject" defect, reconstructed and
+// demonstrated mechanically.
+//
+// HISTORY (verbatim from the phase worklog, Task 4):
+//   "CRITICAL semantic bug found + fixed: reject rules referenced unbound
+//    variable P (cells used _P) -> kore treated P as free existential, making
+//    reject fire with a phantom state. Fixed to named P bound to actual
+//    prospective. All 13 demos re-validated."
+//
+// WHAT IS RECONSTRUCTED HERE
+//   The defective reject rule in its historical shape: the <prospective> cell
+//   is matched anonymously (_P:Map) while the requires clause references a
+//   variable P that no part of the rule pattern binds. kompile v7.1.337
+//   accepts this with ONLY a warning ("Variable 'P' defined but not used");
+//   at rewriting time the backend quantifies P existentially in the rule
+//   condition, so the rule is applicable whenever SOME state violating the
+//   applicable obligations exists -- which is always. Rejection is then
+//   "satisfiable with a phantom state": the gate can reject on the basis of a
+//   state that is not the state being committed.
+//
+//   The accept rule below is the CORRECTED accept rule (verbatim semantics of
+//   SRW3-GATE) so that the accept side is beyond suspicion: every behavioral
+//   difference demonstrated here is attributable to the defective reject rule
+//   alone.
+//
+// NOTE ON FIDELITY: the verbatim defective rule text from the original
+// bring-up session was not preserved in the surviving transcripts; this file
+// is a faithful reconstruction from the recorded worklog description. The
+// reconstruction kompiles and reproduces the recorded behavior (see the
+// demonstration claims and the transcript).
+// =============================================================================
+
+requires "srw3.k"
+
+module SRW3-PHANTOM
+  imports SRW3-CLOSURE        // evalInv / applicable / allHold / member -- NO gate rules
+
+  // setup rule copied verbatim from SRW3-GATE (SRW3-GATE is deliberately NOT
+  // imported here: only the reject rule below differs from the corrected gate)
+  rule <k> useRegistry(K2:RegistryKind) => .K ... </k>
+       <registry> _R:Set => pickRegistry(K2) </registry>
+       <authorities> _As:Set => SetItem(appA) |Set SetItem(appB) |Set SetItem(appC) |Set SetItem(oracle) |Set SetItem(lending) |Set SetItem(liq) </authorities>
+
+  // wfCheck rules copied verbatim from SRW3-GATE
+  rule <k> wfCheck => .K ... </k>
+       <footprint-t> FT:Set </footprint-t>
+       <footprint-d> FD:Set </footprint-d>
+       <policy> enforce </policy>
+    requires subset(FT, FD)
+
+  rule <k> wfCheck => .K ... </k>
+       <footprint-t> _FT:Set </footprint-t>
+       <footprint-d> _FD:Set </footprint-d>
+       <policy> trust </policy>
+
+  rule <k> wfCheck ~> _REST:K => .K </k>
+       <footprint-t> FT:Set </footprint-t>
+       <footprint-d> FD:Set </footprint-d>
+       <policy> enforce </policy>
+       <result> _R:String => "blocked-effect-incomplete" </result>
+       <prospective> _P:Map => .Map </prospective>
+    requires notBool subset(FT, FD)
+
+  // accept rule: CORRECTED form (identical to SRW3-GATE)
+  rule <k> gate => .K ... </k>
+       <prospective> P:Map => .Map </prospective>
+       <committed> _C:Map => P </committed>
+       <registry> R:Set </registry>
+       <footprint-t> _FT:Set => .Set </footprint-t>
+       <footprint-d> FD:Set => .Set </footprint-d>
+       <actor> Ac:AppId </actor>
+       <authorities> As:Set </authorities>
+       <polver> PV:Int </polver>
+       <lineage> LN:Map => LN:Map [ N:Int <- lin(CH:Commitment, N:Int, auth(Ac), PV, commit(N:Int)) ] </lineage>
+       <lineageNext> N:Int => N +Int 1 </lineageNext>
+       <head> CH:Commitment => commit(N:Int) </head>
+       <result> _R:String => "commit" </result>
+    requires member(Ac, As) andBool allHold(applicable(R, FD), P)
+
+  // ==== THE DEFECT (reconstructed) ============================================
+  // <prospective> is matched anonymously; requires references P, which NO
+  // pattern binds. kompile: Warning "Variable 'P' defined but not used".
+  // Backend: P becomes existentially quantified in the condition => the rule
+  // fires whenever some phantom state violates the obligations => always.
+  rule <k> gate => .K ... </k>
+       <prospective> _P:Map => .Map </prospective>
+       <registry> R2:Set </registry>
+       <footprint-t> _FT2:Set => .Set </footprint-t>
+       <footprint-d> FD2:Set => .Set </footprint-d>
+       <result> _R2:String => "reject" </result>
+    requires notBool allHold(applicable(R2, FD2), P)
+endmodule
+
+// =============================================================================
+// Demonstration claims.
+//
+// D-FALSE-REJECT : an HONEST transition (all obligations hold on the real
+//   prospective state) "results in reject with committed unchanged".
+//   False of the intended model. Under the defect, the phantom reject rule
+//   fires on every gate step, so this false claim sits on a live execution
+//   path (krun shows honest transitions nondeterministically rejecting; the
+//   krun transcript records the phantom firing).
+//
+// D-VIOLATION-REJECT : the (true) gate-coverage claim, Claim 2's statement.
+//   Under the defect this still "proves" -- but for the WRONG reason: the
+//   phantom rule fires regardless of the real state, so "the gate rejects bad
+//   transitions" holds VACUOUSLY, without the gate ever evaluating the real
+//   prospective state. This is why the defect is fatal to the proof suite's
+//   evidential value even where the claims still pass.
+// =============================================================================
+
+module SRW3-PHANTOM-CLAIMS
+  imports SRW3-PHANTOM
+
+  claim // D-FALSE-REJECT: honest transition "rejects" -- FALSE of the intended model
+    <k> w(appB, 0, V:Int) ~> gate => .K </k>
+    <committed> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int
+             => stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int </committed>
+    <prospective> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int => .Map </prospective>
+    <footprint-t> _FT:Set => .Set </footprint-t>
+    <footprint-d> SetItem(appB) => .Set </footprint-d>
+    <registry> completeRegistry() </registry>
+    <policy> _Pol:Policy </policy>
+    <authorities> As:Set </authorities>
+    <actor> appB </actor>
+    <result> _R:String => "reject" </result>
+    requires X <=Int 10 andBool Y <=Int 10 andBool V <=Int 10
+             andBool X +Int V <=Int 10 andBool member(appB, As)
+
+  claim // D-VIOLATION-REJECT: Claim 2's statement -- holds VACUOUSLY under the defect
+    <k> w(appB, 0, V:Int) ~> gate => .K </k>
+    <committed> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int
+             => stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int </committed>
+    <prospective> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int => .Map </prospective>
+    <footprint-t> _FT:Set => .Set </footprint-t>
+    <footprint-d> SetItem(appB) => .Set </footprint-d>
+    <registry> completeRegistry() </registry>
+    <policy> _Pol:Policy </policy>
+    <authorities> As:Set </authorities>
+    <actor> appB </actor>
+    <result> _R:String => "reject" </result>
+    requires X +Int V >Int 10 andBool member(appB, As)
+endmodule
+
+// =============================================================================
+// ACCEPT-SIDE COLLAPSE CHECK (run against the DEFECTIVE definition):
+// a verbatim copy of the PROVED Claim 4a. Under the corrected gate it is
+// PROVED (see kprove_claims_final.txt). Under the defective gate the phantom
+// reject path leaves <committed> unchanged with result "reject", so the
+// claim's RHS is unreachable on that path -> the accept-side proof suite
+// COLLAPSES. This is the mechanical proof that every accept-side claim
+// (Claims 1, 3, 4a) depends on the corrected reject rule.
+// =============================================================================
+module SRW3-PHANTOM-ACCEPT-CLAIM
+  imports SRW3-PHANTOM
+
+  claim // verbatim Claim 4a (proved under SRW3-GATE) -- expected to FAIL here
+    <k> w(appB, 0, V:Int) ~> gate => .K </k>
+    <committed> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int
+             => stK(appA, 0) |-> X:Int stK(appB, 0) |-> V:Int </committed>
+    <prospective> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int => .Map </prospective>
+    <footprint-t> _FT:Set => .Set </footprint-t>
+    <footprint-d> SetItem(appB) => .Set </footprint-d>
+    <registry> completeRegistry() </registry>
+    <policy> enforce </policy>
+    <authorities> As:Set </authorities>
+    <polver> 1 </polver>
+    <actor> appB </actor>
+    <lineage> LN:Map => LN:Map [ N:Int <- lin(CH:Commitment, N:Int, auth(appB), 1, commit(N:Int)) ] </lineage>
+    <lineageNext> N:Int => N +Int 1 </lineageNext>
+    <head> CH:Commitment => commit(N:Int) </head>
+    <result> _R:String => "commit" </result>
+    requires X <=Int 10 andBool Y <=Int 10 andBool X +Int Y <=Int 10
+             andBool V <=Int 10 andBool X +Int V <=Int 10
+             andBool member(appB, As)
+             andBool securityClosedUniv(completeRegistry(), enforce, minInvs())
+endmodule
+
+// =============================================================================
+// CORRECTED-SIDE CONTROL (run against the CORRECTED definition hs-out):
+// the same false "honest -> reject" claim under the corrected gate. Expected:
+// correctly FAILS (the only path is accept, whose result is "commit") -- the
+// false statement sits on NO execution path of the corrected model.
+// =============================================================================
+module SRW3-CORR-FALSE-REJECT
+  imports SRW3-GATE
+
+  claim // same statement as D-FALSE-REJECT, corrected gate -- expected to FAIL
+    <k> w(appB, 0, V:Int) ~> gate => .K </k>
+    <committed> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int
+             => stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int </committed>
+    <prospective> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int => .Map </prospective>
+    <footprint-t> _FT:Set => .Set </footprint-t>
+    <footprint-d> SetItem(appB) => .Set </footprint-d>
+    <registry> completeRegistry() </registry>
+    <policy> _Pol:Policy </policy>
+    <authorities> As:Set </authorities>
+    <actor> appB </actor>
+    <result> _R:String => "reject" </result>
+    requires X <=Int 10 andBool Y <=Int 10 andBool V <=Int 10
+             andBool X +Int V <=Int 10 andBool member(appB, As)
+endmodule
diff --git a/srw3-kevm/proofs/generalized_bridge.k b/srw3-kevm/proofs/generalized_bridge.k
new file mode 100755
index 0000000..67c0560
--- /dev/null
+++ b/srw3-kevm/proofs/generalized_bridge.k
@@ -0,0 +1,175 @@
+// =============================================================================
+// proofs/generalized_bridge.k — Round-2 theorem-boundary audit, item 2
+//
+// GENERALIZATION OF THE SCAFFOLD RECONCILIATION.
+//
+// AUDIT QUESTION (verbatim): can
+//     wfCheck(state) -> gateOk_faithful(state) = implementedGate(state)
+// be proved as a general property, or does the exact formulation require a
+// more precise coverage predicate?
+//
+// ANSWER. wfCheck alone (Gamma* ⊆ GammaHat, effect completeness) is NECESSARY
+// but NOT SUFFICIENT for agreement: a state can have its true effects fully
+// declared while some obligation on an UNTOUCHED application is already
+// violated in the inherited state (e.g. a trust-policy commit left appC=11;
+// a later clean, fully-declared appB write passes wfCheck yet the faithful
+// all-universe check rejects while the implemented applicable-only check
+// accepts). The precise predicate under which the two decisions coincide is:
+//
+//     wfCoverage(H, FD, S)  :=  ∀ edge(J, Xs) ∈ H.
+//                                 ( Xs ∩ FD ≠ ∅  ∨  evalInv(J, S) )
+//
+// i.e. every obligation the declared footprint fails to make applicable is
+// already satisfied by the state. Under it, the universe-wide check (faithful
+// gateOk) and the footprint-applicable check (implemented gate) coincide.
+//
+// THE GENERAL THEOREM (stated here; NOT YET MECHANIZED — see below):
+//
+//   For all hypergraphs H, declared footprints FD, states S, actor Ac and
+//   root sets R/As with the name-coincidence premise (ActorName = appName(Ac),
+//   R = As):
+//
+//       wfCoverage(H, FD, S)  ∧  rootOk(R, appName(Ac), tid)
+//       ======================================================
+//       ( gateOk(C, S, TR, R, H, M) ∧ rootOk(R, appName(Ac), tid) )
+//         ==  gateAccept(H, FD, Ac, As, S)
+//
+//   Why it holds (sketch): applicable(H, FD) ⊆ universeObls(H); and
+//     allHold(universeObls(H), S)
+//       =  allHold(applicable(H, FD), S)
+//          ∧ ∧_{edge(J,Xs) ∈ H, Xs ∩ FD = ∅} evalInv(J, S),
+//   where wfCoverage makes every skipped conjunct true; the authorization
+//   conjuncts coincide by evaluation of memberName/member under the
+//   name-coincidence premise.
+//
+//   Why NOT mechanized: with H, FD, S fully symbolic, wfCoverage,
+//   universeObls, applicable and allHold are recursive functions over a
+//   constructor-free symbolic Set/Map and do not reduce; the identity needs
+//   structural induction over symbolic aggregates, which the Haskell
+//   backend's reachability+SMT fragment does not support — the SAME prover
+//   boundary documented for the lineage-length induction (§F.4, attempt [B]).
+//
+//   What IS mechanized below: per-(registry, footprint) instances of the
+//   theorem with SYMBOLIC STATE VALUES (G8-G11) — genuine universal
+//   statements over all states of the covered shapes, not ground decisions —
+//   plus one ground necessity witness (X3) showing the coverage premise
+//   cannot be dropped.
+//
+// TERMINOLOGY (mandated): the reconciliation result is therefore a
+// "signature-faithful realization with mechanically checked ground agreement
+// over the covered states" — extended here with mechanically checked
+// state-generalized agreement on the covered (registry, footprint) pairs.
+// It is NOT called a refinement/simulation theorem: the fully quantified
+// ∀H ∀FD ∀S statement above is not mechanized.
+//
+// Relationship to the safety theorem: on the ENFORCE system's reachable
+// states, wfCoverage holds by the frame argument — a transition writes only
+// keys of apps in FT ⊆ FD (wfCheck), so every skipped edge's keys are
+// untouched and evalInv(J, σ̂) = evalInv(J, σ_n), which the induction
+// hypothesis Safe(P, σ_n) makes true. This is the precise semantic link
+// between the commitment-gate safety theorem and the gate-agreement theorem;
+// under policy `trust` the link breaks and X1 (bridge) is the divergence.
+// =============================================================================
+
+requires "srw3.k"
+requires "compat/srw3-bridge.k"
+
+module SRW3-BRIDGE-GEN
+  imports SRW3-BRIDGE
+
+  // ---- the coverage predicate -----------------------------------------------
+  syntax Bool ::= "wfCoverage" "(" edges:Set "," foot:Set "," st:Map ")" [function, total]
+  rule wfCoverage(.Set, _F:Set, _S:Map) => true
+  rule wfCoverage(SetItem(edge(J:InvId, Xs:Set)) Es:Set, F:Set, S:Map)
+    => ( nonemptyInter(Xs, F) orBool evalInv(J, S) ) andBool wfCoverage(Es, F, S)
+  rule wfCoverage(SetItem(bareEdge(_Xs:Set)) Es:Set, F:Set, S:Map)
+    => wfCoverage(Es, F, S)
+
+  // symbolic chain-state generator (shape mirrors gChain: 6 storage keys)
+  syntax Map ::= "gSgen" "(" Int "," Int "," Int "," Int "," Int "," Int ")" [function, total]
+  rule gSgen(PR:Int, AU:Int, LP:Int, LD:Int, LT:Int, LL:Int)
+    => stK(oracle, 0)  |-> PR  stK(oracle, 1)  |-> AU
+       stK(lending, 0) |-> LP  stK(lending, 1) |-> LD
+       stK(liq, 0)     |-> LT  stK(liq, 1)     |-> LL
+endmodule
+
+// =============================================================================
+// State-generalized agreement claims. S carries SYMBOLIC values; the requires
+// is the coverage predicate VERBATIM (evaluated per instance). kprove checks
+// the equality by evaluation over all values of the symbolic variables
+// (WarnTrivialClaim = checked-by-evaluation; the quantification is what makes
+// these more than the ground G-claims of the original bridge).
+// =============================================================================
+
+module SRW3-BRIDGE-GEN-CLAIMS
+  imports SRW3-BRIDGE-GEN
+
+  claim // G8: completeRegistry, FD = {appB}; skipped edges {IA, IC}; coverage
+        // premise reduces to X <= 10. Agreement holds for ALL symbolic X, V.
+    <k> ( rootOk(gAuth6(), "appB", "t0")
+          andBool gateOk(.Map, stK(appA, 0) |-> X:Int stK(appB, 0) |-> V:Int,
+                         .List, gAuth6(), completeRegistry(), .Map) )
+        ==Bool
+        gateAccept(completeRegistry(), SetItem(appB), appB, gAuth6(),
+                   stK(appA, 0) |-> X stK(appB, 0) |-> V)
+        => true
+    </k>
+    requires wfCoverage(completeRegistry(), SetItem(appB),
+                        stK(appA, 0) |-> X stK(appB, 0) |-> V)
+
+  claim // G9: chainCompleteRegistry, FD = {lending}; skipped edge {IO}; the
+        // coverage premise is exactly oracle authentication (AU == 1).
+    <k> ( rootOk(gAuth6(), "lending", "t0")
+          andBool gateOk(.Map, gSgen(PR:Int, AU:Int, LP:Int, LD:Int, LT:Int, LL:Int),
+                         .List, gAuth6(), chainCompleteRegistry(), .Map) )
+        ==Bool
+        gateAccept(chainCompleteRegistry(), SetItem(lending), lending, gAuth6(),
+                   gSgen(PR, AU, LP, LD, LT, LL))
+        => true
+    </k>
+    requires wfCoverage(chainCompleteRegistry(), SetItem(lending),
+                        gSgen(PR, AU, LP, LD, LT, LL))
+
+  claim // G10: chainCompleteRegistry, FD = {liq}; skipped edges {IO, IOL};
+        // coverage premise: oracle authenticated AND lending price consistent.
+    <k> ( rootOk(gAuth6(), "liq", "t0")
+          andBool gateOk(.Map, gSgen(PR:Int, AU:Int, LP:Int, LD:Int, LT:Int, LL:Int),
+                         .List, gAuth6(), chainCompleteRegistry(), .Map) )
+        ==Bool
+        gateAccept(chainCompleteRegistry(), SetItem(liq), liq, gAuth6(),
+                   gSgen(PR, AU, LP, LD, LT, LL))
+        => true
+    </k>
+    requires wfCoverage(chainCompleteRegistry(), SetItem(liq),
+                        gSgen(PR, AU, LP, LD, LT, LL))
+
+  claim // G11: negativeRegistry (CM1 registry!), FD = {appB}; skipped {IA};
+        // agreement STILL holds state-generally under coverage — the CM1
+        // defect is closure-level (InteractionComplete false), not gate-level.
+    <k> ( rootOk(gAuth6(), "appB", "t0")
+          andBool gateOk(.Map, stK(appA, 0) |-> X:Int stK(appB, 0) |-> V:Int,
+                         .List, gAuth6(), negativeRegistry(), .Map) )
+        ==Bool
+        gateAccept(negativeRegistry(), SetItem(appB), appB, gAuth6(),
+                   stK(appA, 0) |-> X stK(appB, 0) |-> V)
+        => true
+    </k>
+    requires wfCoverage(negativeRegistry(), SetItem(appB),
+                        stK(appA, 0) |-> X stK(appB, 0) |-> V)
+
+  // ---- necessity witness: the coverage premise cannot be dropped -----------
+  claim // X3 (ground): oracle UNAUTHENTICATED (AU = 0) but every applicable
+        // obligation consistent — the implemented gate (footprint {lending})
+        // ACCEPTS while the faithful all-universe instantiation REJECTS.
+        // Pure effect-completeness (wfCheck) does not produce this state:
+        // it arises from an inherited violation on an untouched app.
+    <k> notBool (
+          ( rootOk(gAuth6(), "lending", "t0")
+            andBool gateOk(.Map, gSgen(100, 0, 100, 5, 4, 100),
+                           .List, gAuth6(), chainCompleteRegistry(), .Map) )
+          ==Bool
+          gateAccept(chainCompleteRegistry(), SetItem(lending), lending,
+                     gAuth6(), gSgen(100, 0, 100, 5, 4, 100))
+        ) => true
+    </k>
+endmodule
