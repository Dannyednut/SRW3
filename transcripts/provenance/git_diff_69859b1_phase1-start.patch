index 0000000..7d2e118
--- /dev/null
+++ b/srw3-kevm/proofs/induction_record.k
@@ -0,0 +1,126 @@
+// =============================================================================
+// proofs/induction_record.k — Attempt [C]
+//
+// PRIORITY-2 AUDIT ARTIFACT. The SAME full lineage-length safety induction,
+// over a record encoding of the minimal model's REACHABLE state space.
+//
+// Faithfulness of the restriction (minimal model, universe {IA,IB,IAB}):
+//   * committed state = record (xa,xb); prospective (pa,pb); begin copies;
+//   * the only write is w(appB,0,V) => pb := V; footprint {appB}; wfCheck
+//     passes trivially;
+//   * gate accept iff the applicable obligations on the prospective record —
+//     exactly {IB, IAB} = applicable(completeRegistry(), {appB}) — hold:
+//     V <= 10  /\  xa + V <= 10; accept sets (xa,xb) := (xa,V); reject keeps;
+//   * key sets are preserved by transitions, so every REACHABLE committed
+//     state of the minimal model is faithfully a record (xa,xb); the Map
+//     encoding's extra generality (arbitrary key sets) is unreachable.
+//
+// The theorem is stated in refutation-proof form: every program is a
+// nonempty sequence of transition attempts TERMINATED by the observer `chk`,
+// whose only rule requires the committed record to be safe. The claim
+// "every such program reaches <k> .K </k>" therefore PROVES iff no path ever
+// commits an unsafe state: were the gate to accept an unsafe state, chk
+// could not fire and the path would stick. The [circularity] reuse of the
+// claim at each unrolled tail re-establishes safe(xa,xb) — the induction
+// hypothesis over committed lineage length. No ghost state; the end-state
+// safety is enforced by chk's rule, not by an unconstrained RHS.
+// =============================================================================
+
+module SRW3-RECORD
+  imports DOMAINS
+
+  configuration <srw3r>
+                  <k> $PGM:TProg </k>
+                  <xa> 0 </xa>
+                  <xb> 0 </xb>
+                  <pa> 0 </pa>
+                  <pb> 0 </pb>
+                  <result> "" </result>
+                </srw3r>
+
+  syntax TauStep ::= "tB" "(" Int ")" | "w2" "(" Int ")" | "g2"
+  syntax TProg ::= "chk" | TauStep ":" TProg
+
+  rule <k> (T:TauStep : P2:TProg) => T ~> P2 ... </k>
+
+  // begin: prospective := committed record
+  rule <k> tB(V:Int) => w2(V) ... </k>
+       <xa> X:Int </xa> <xb> Y:Int </xb>
+       <pa> _PA:Int => X </pa> <pb> _PB:Int => Y </pb>
+
+  // w(appB,0,V): pb := V  (footprint {appB}; wfCheck trivially passes)
+  rule <k> w2(V:Int) => g2 ... </k> <pb> _P2:Int => V </pb>
+
+  // gate ACCEPT: applicable obligations {IB, IAB} hold on prospective
+  rule <k> g2 => .K ... </k>
+       <xa> X:Int </xa> <xb> _Y:Int => V:Int </xb>
+       <pa> _PA2:Int => 0 </pa> <pb> V:Int => 0 </pb>
+       <result> _R:String => "commit" </result>
+    requires V <=Int 10 andBool X +Int V <=Int 10
+
+  // gate REJECT: no committed update (the commitment boundary)
+  rule <k> g2 => .K ... </k>
+       <xa> X:Int </xa> <xb> _YR:Int </xb>
+       <pa> _PA3:Int => 0 </pa> <pb> V:Int => 0 </pb>
+       <result> _R2:String => "reject" </result>
+    requires notBool ( V <=Int 10 andBool X +Int V <=Int 10 )
+
+  // observer: executable ONLY on a safe committed record
+  rule <k> chk => .K ... </k>
+       <xa> X:Int </xa> <xb> Y:Int </xb>
+    requires X <=Int 10 andBool Y <=Int 10 andBool X +Int Y <=Int 10
+endmodule
+
+// --- claims that PROVE (machine-checked induction step on the record encoding)
+module SRW3-RECORD-CLAIMS-PROVED
+  imports SRW3-RECORD
+
+  claim // [C-a] 4a-shape, record encoding: an admissible transition commits W
+        // and the committed record (X,W) satisfies Safe (destination pinned;
+        // no observer; all destination values LHS-bound).
+    <k> tB(W:Int) => .K </k>
+    <xa> X:Int </xa>
+    <xb> Y:Int => W:Int </xb>
+    <pa> _PA:Int => 0 </pa>
+    <pb> _PB:Int => 0 </pb>
+    <result> _R:String => "commit" </result>
+    requires X <=Int 10 andBool Y <=Int 10 andBool X +Int Y <=Int 10
+             andBool W <=Int 10 andBool X +Int W <=Int 10
+    [label(record-4a)]
+
+  claim // [C-b] 4b-shape, record encoding: an inadmissible transition cannot
+        // commit; the committed record (X,Y) is unchanged and safe.
+    <k> tB(W:Int) => .K </k>
+    <xa> X:Int </xa>
+    <xb> Y:Int </xb>
+    <pa> _PA2:Int => 0 </pa>
+    <pb> _PB2:Int => 0 </pb>
+    <result> _R2:String => "reject" </result>
+    requires X <=Int 10 andBool Y <=Int 10 andBool X +Int Y <=Int 10
+             andBool notBool ( W <=Int 10 andBool X +Int W <=Int 10 )
+    [label(record-4b)]
+endmodule
+
+// --- full-theorem ATTEMPTS (record encoding) — expected STUCK; verbatim
+// --- residuals are recorded in the audit transcript and analyzed in the report
+module SRW3-RECORD-CLAIM-ATTEMPT
+  imports SRW3-RECORD
+
+  claim // [C-attempt-1] one cycle + chk observer (termination-form step).
+        // STUCK: kore destination handling loses the rule-produced value
+        // linkage (residual #Not(?YB = W /\ ...) recorded verbatim).
+    <k> ( tB(W:Int) : chk ) => .K </k>
+    <xa> X:Int </xa>
+    <xb> Y:Int => W:Int </xb>
+    requires X <=Int 10 andBool Y <=Int 10 andBool X +Int Y <=Int 10
+             andBool W <=Int 10 andBool X +Int W <=Int 10
+
+  claim // [C-attempt-2] FULL theorem as [circularity]: every chk-terminated
+        // program from a safe record terminates. STUCK: same destination
+        // residual at the first circular reuse.
+    <k> P3:TProg => .K </k>
+    <xa> X:Int </xa>
+    <xb> Y:Int </xb>
+    requires X <=Int 10 andBool Y <=Int 10 andBool X +Int Y <=Int 10
+    [circularity]
+endmodule
diff --git a/srw3-kevm/proofs/negative_control.k b/srw3-kevm/proofs/negative_control.k
new file mode 100755
index 0000000..ee279a6
--- /dev/null
+++ b/srw3-kevm/proofs/negative_control.k
@@ -0,0 +1,23 @@
+// Negative control: a deliberately FALSE claim — a transition violating IAB
+// must NOT be provable to commit. kprove is expected to REFUTE/STUCK on this.
+// If kprove "proves" this, the prover configuration is unsound and all
+// results above are void.
+requires "srw3.k"
+
+module SRW3-NEGCONTROL
+  imports SRW3-GATE
+
+  claim // FALSE: gate coverage violation — expecting proof FAILURE
+    <k> w(appB, 0, V:Int) ~> gate => .K </k>
+    <committed> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int
+             => stK(appA, 0) |-> X:Int stK(appB, 0) |-> V:Int </committed>
+    <prospective> stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int => .Map </prospective>
+    <footprint-t> _FT:Set => .Set </footprint-t>
+    <footprint-d> SetItem(appB) => .Set </footprint-d>
+    <registry> completeRegistry() </registry>
+    <policy> _Pol:Policy </policy>
+    <authorities> As:Set </authorities>
+    <actor> appB </actor>
+    <result> _R:String => "commit" </result>
+    requires X +Int V >Int 10 andBool member(appB, As)
+endmodule
diff --git a/srw3-kevm/proofs/safe_form_audit.k b/srw3-kevm/proofs/safe_form_audit.k
new file mode 100755
index 0000000..41cfc99
--- /dev/null
+++ b/srw3-kevm/proofs/safe_form_audit.k
@@ -0,0 +1,82 @@
+// =============================================================================
+// proofs/safe_form_audit.k — Round-2 theorem-boundary audit, item 1
+//
+// MACHINE-CHECKED PREMISE-FORM EQUIVALENCES for Claims 4a/4b (SRW3-CLAIMS).
+//
+// AUDIT QUESTION (verbatim from the instructions):
+//   "Determine whether Claim 4a and Claim 4b use a genuine predecessor-state
+//    safety premise of the form Safe(P, sigma) or an equivalent predicate,
+//    rather than merely an InitialSafe(...) premise whose semantic meaning is
+//    restricted to the designated initial state."
+//
+// FINDING (analytic, confirmed by the claims below):
+//   * The requires clauses of 4a/4b contain NO InitialSafe predicate and pin
+//     NO initial values: X and Y are universally quantified symbolic Ints.
+//     The word "InitialSafe" occurs in srw3.k only in a comment describing
+//     that the base constraint is evaluated, not assumed.
+//   * The predecessor constraint  X <= 10 /\ Y <= 10 /\ X + Y <= 10  is the
+//     evaluated conjunction of the minimal-model obligation universe
+//     minInvs() = {IA, IB, IAB, IC} over the committed state
+//     {appA |-> X, appB |-> Y} (IC holds vacuously there — SF0 below).
+//   * 4a's accept-side conjuncts  V <= 10 /\ X + V <= 10  are exactly the
+//     gate's evaluated applicable-obligation conjunction on the prospective
+//     state, i.e. the Accepted(sigma_n, tau) premise (SF2).
+//   * 4b's disjunction  V > 10 \/ X + V > 10  is exactly the negation of
+//     that conjunction, i.e. the Rejected(sigma_n, tau) premise (SF3).
+//   * The remaining premises of 4a/4b (securityClosedUniv, authorization)
+//     are theorem-level system premises (SecurityClosed / root authority),
+//     not restrictions of the safety predicate to an initial state.
+//
+//   => VERDICT: PROVED. 4a/4b are valid induction steps whose premises are
+//      Safe(P, sigma_n) in evaluated form. The full lineage-length theorem
+//      remains separately BLOCKED at mechanization (§F.4 blockers) — that is
+//      a packaging boundary, NOT a premise defect.
+//
+// Epistemic status: like the bridge G-claims, these are checked by
+// evaluation (WarnTrivialClaim = checked-by-evaluation); the difference from
+// a ground decision is UNIVERSAL QUANTIFICATION: X, Y, V range over all
+// integers, so each claim is an identity between evaluated formulas.
+// =============================================================================
+
+requires "srw3.k"
+
+module SRW3-SAFE-FORM
+  imports SRW3-GATE
+
+  // The named safety predicate, verbatim the observer predicate of
+  // proofs/induction_full.k (chkS's requires), restated locally so this
+  // artifact is self-contained.
+  syntax Bool ::= "safeForm" "(" st:Map ")" [function, total]
+  rule safeForm(M2:Map)
+    => lookupInt(M2, stK(appA, 0)) <=Int 10
+       andBool lookupInt(M2, stK(appB, 0)) <=Int 10
+       andBool lookupInt(M2, stK(appA, 0)) +Int lookupInt(M2, stK(appB, 0)) <=Int 10
+endmodule
+
+module SRW3-SAFE-FORM-CLAIMS
+  imports SRW3-SAFE-FORM
+
+  claim // SF0: IC is vacuous on the two-key shape (never-written slot reads 0,
+        // mirroring EVM SLOAD semantics) — why the universe reduces to 3 checks
+    <k> evalInv(IC, stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int) => true </k>
+
+  claim // SF1: the inlined 4a/4b predecessor constraint IS the named safety
+        // predicate, for ALL symbolic X, Y  (premise form = Safe(P, sigma_n))
+    <k> safeForm(stK(appA, 0) |-> X:Int stK(appB, 0) |-> Y:Int)
+        ==Bool ( X <=Int 10 andBool Y <=Int 10 andBool X +Int Y <=Int 10 )
+        => true </k>
+
+  claim // SF2: 4a's accept-side conjuncts ARE the gate's applicable-obligation
+        // conjunction on the prospective state  (= Accepted(sigma_n, tau))
+    <k> allHold(applicable(completeRegistry(), SetItem(appB)),
+                stK(appA, 0) |-> X:Int stK(appB, 0) |-> V:Int)
+        ==Bool ( V <=Int 10 andBool X +Int V <=Int 10 )
+        => true </k>
+
+  claim // SF3: 4b's rejection disjunction IS the exact negation of the gate's
+        // accept condition  (= Rejected(sigma_n, tau))
+    <k> notBool allHold(applicable(completeRegistry(), SetItem(appB)),
+                        stK(appA, 0) |-> X:Int stK(appB, 0) |-> V:Int)
+        ==Bool ( V >Int 10 orBool X +Int V >Int 10 )
+        => true </k>
+endmodule
