+++ b/srw3-kevm/verify_baseline.sh
@@ -0,0 +1,67 @@
+#!/bin/bash
+# =============================================================================
+# SRW3 Phase 0-D — Baseline verification harness (Task 8)
+# Run THIS as soon as the Phase 0-D baseline (Python reference + K scaffold)
+# is uploaded/placed in this workspace. It fills report section C with real
+# compile/test results for the ORIGINAL artifacts — no reconstruction, no
+# divergence.
+#
+# Usage: bash verify_baseline.sh <path-to-baseline-dir>
+# =============================================================================
+set -uo pipefail
+BASE="${1:?usage: verify_baseline.sh <path-to-baseline-dir>}"
+source /home/z/my-project/tools/env.sh
+OUT="$SRW3/transcripts/baseline_section_C.txt"
+mkdir -p "$SRW3/transcripts"
+: > "$OUT"
+
+log() { echo "$@" | tee -a "$OUT"; }
+
+log "# Section C — Existing scaffold result (generated $(date -Iseconds))"
+log "Baseline dir: $BASE"
+log
+
+# ---- toolchain pin echo ----
+log "## Toolchain used"
+kompile --version 2>&1 | head -2 | tee -a "$OUT"
+python3 --version | tee -a "$OUT"
+log
+
+# ---- locate artifacts ----
+log "## Artifact inventory"
+find "$BASE" -maxdepth 3 \( -name "*.py" -o -name "*.k" -o -name "Makefile" -o -name "README*" -o -name "pytest.ini" -o -name "requirements*.txt" \) -print | tee -a "$OUT"
+log
+
+# ---- Python reference tests ----
+if find "$BASE" -name "test_*.py" -o -name "*_test.py" | grep -q .; then
+  log "## Python test suite"
+  PDIR=$(dirname "$(find "$BASE" -name "test_*.py" | head -1)")
+  (cd "$PDIR" && python3 -m pytest -q 2>&1) | tee -a "$OUT"
+  log
+fi
+
+# ---- K scaffold compilation (UNMODIFIED — compile only, per handoff §6) ----
+KFILE=$(find "$BASE" -name "*.k" | head -1)
+if [ -n "$KFILE" ]; then
+  log "## K scaffold compile: $KFILE (UNMODIFIED)"
+  KMAIN=$(grep -oE "module [A-Z0-9-]+" "$KFILE" | head -1 | awk '{print $2}')
+  log "Detected main module candidate: $KMAIN"
+  kompile "$KFILE" --backend haskell --main-module "$KMAIN" --syntax-module "$KMAIN" \
+    -o "$BASE/kompiled-baseline" 2>&1 | tee -a "$OUT"
+  log "kompile exit: $?"
+  log
+  # krun smoke test if a demo/program exists
+  if find "$BASE" -name "*.srw3" -o -name "*.evm" -o -name "*.in" | grep -q .; then
+    log "## krun smoke test on provided programs"
+    for P in $(find "$BASE" -name "*.srw3" -o -name "*.evm" | head -3); do
+      log "--- $P"
+      krun "$P" -d "$BASE/kompiled-baseline" 2>&1 | head -20 | tee -a "$OUT"
+    done
+  fi
+else
+  log "No .k file found in baseline — K scaffold compilation skipped."
+fi
+
+log
+log "# End of section C capture"
+echo "Section C evidence written to $OUT"
