// =============================================================================
// SRW3 PHASE 1M — THE TOTAL DETERMINISTIC KECCAK-256 EVALUATOR (pure K,
//                    PACKED-INT STATE; generated by
//                    scripts/gen_keccak_total_packed.py — do not hand-edit)
//                    (phase1m/semantics/keccak256_total.k)
//
// THE HASH-DEFINEDNESS BLOCKER (phase1l/audit/induction-diagnosis.md B1),
// REMOVED BY CONSTRUCTION: the KRYPTO Keccak256raw HOOK is partial on the
// Haskell backend (no evaluator over symbolic/hash-containing arguments), so
// every proof path that MATERIALIZES a hash application over such arguments
// dies with an undischargeable #Ceil(Keccak256raw(...)).  THIS module defines
// Keccak256T: a REAL, DETERMINISTIC, TOTAL Keccak-256 evaluator written in
// plain K rules (NO hooks) — Keccak-f[1600], 24 rounds, rate 136 bytes,
// ORIGINAL Keccak padding (0x01 ... 0x80 — the Ethereum KRYPTO.keccak256raw
// convention), little-endian lane load/store.
//
// ENCODING: the state is ONE 1600-bit Int (lane i = x + 5*y at bits
// 64i .. 64i+63); every stage is a fully-literal-indexed pure-Int reduction.
// This replaces the FIRST attempt (a Map-keyed state; preserved with its
// disposition at phase1m/audit/failed-attempts/ — the Haskell-backend krun
// of the full hash was killed, exit 137, on the 4 GB host: the map-update
// churn of the round stages exhausted memory).  The packed encoding has NO
// map updates and NO linear scans; the algorithm is IDENTICAL (same tables,
// same padding, same lane order) and is pinned to the Keccak-256 test
// vectors and cross-checked BYTE-FOR-BYTE against the backend hook
// Keccak256raw (real Keccak, LLVM krypto shim) — see the M2 validation
// transcripts.
//
//   * TOTAL by the [function,total] annotation AND by construction: the
//     padding rules partition lengthBytes(M) modInt 136 exactly (0 / 135 /
//     interior); the absorb rules partition the padded stream by
//     lengthBytes == 0 / == 136 / > 136 (the padded stream is always a
//     positive multiple of 136); every stage is a literal-indexed pure-Int
//     reduction.  #Ceil(Keccak256T(x)) therefore discharges for EVERY
//     argument — literal, symbolic, or nested-hash.
//   * DETERMINISTIC and EXACT: pinned to the Keccak-256 test vectors (the
//     empty string c5d24601...a470, "abc" 4e03657a...6c45, the 135/136/137
//     boundary vectors, and a two-block 215-byte vector) — M2 transcripts,
//     executed on BOTH backends.
//   * NO hash EQUALITY, collision resistance, preimage resistance, or
//     injectivity is assumed or derived anywhere: the evaluator COMPUTES;
//     hash equalities remain claim hypotheses where they are hypotheses,
//     and the M2 negative controls enforce that totality grants no
//     equality power (the weakened controls must keep failing).
//   * PROOF FACING: the M2 machine's hash leaf LinH is redirected to
//     Keccak256T by a priority rule (the machine-side redirect); the frozen
//     machine's executable tier keeps the real hook.  On concrete inputs
//     the two agree byte-for-byte (the pinned vectors); on symbolic inputs
//     Keccak256T stays a defined opaque term (no Ceil) where Keccak256raw
//     was UNDEFINED (the blocker).
// =============================================================================

module KECCAK256-TOTAL
  imports INT-SYNTAX
  imports INT-COMMON
  imports BOOL
  imports BYTES

  // ---------------------------------------------------------------------
  // 64-bit mask / rotation / lane access on the packed state
  // ---------------------------------------------------------------------
  syntax Int ::= "KMask64" [function, total]
  rule KMask64 => 18446744073709551615

  syntax Int ::= KRotT ( Int , Int ) [function, total]
  rule KRotT(V:Int, 0) => V
  rule KRotT(V:Int, N:Int)
    => ( ( V <<Int N ) |Int ( V >>Int ( 64 -Int N ) ) ) &Int KMask64
    requires N >Int 0 andBool N <Int 64

  // lane i lives at bits 64i .. 64i+63 of the packed state
  syntax Int ::= KLaneT ( Int , Int ) [function, total]
  rule KLaneT(S:Int, I:Int) => ( S >>Int ( 64 *Int I ) ) &Int KMask64

  syntax Int ::= KSetLaneT ( Int , Int , Int ) [function, total]
  rule KSetLaneT(S:Int, I:Int, V:Int)
    => ( S &Int ~Int ( KMask64 <<Int ( 64 *Int I ) ) )
       |Int ( ( V &Int KMask64 ) <<Int ( 64 *Int I ) )

  syntax Int ::= KNot64T ( Int ) [function, total]
  rule KNot64T(X:Int) => X xorInt KMask64

  // ---------------------------------------------------------------------
  // Round constants (Keccak-f[1600], 24 rounds)
  // ---------------------------------------------------------------------
  syntax Int ::= KRC ( Int ) [function, total]
  rule KRC(0) => 1
  rule KRC(1) => 32898
  rule KRC(2) => 9223372036854808714
  rule KRC(3) => 9223372039002292224
  rule KRC(4) => 32907
  rule KRC(5) => 2147483649
  rule KRC(6) => 9223372039002292353
  rule KRC(7) => 9223372036854808585
  rule KRC(8) => 138
  rule KRC(9) => 136
  rule KRC(10) => 2147516425
  rule KRC(11) => 2147483658
  rule KRC(12) => 2147516555
  rule KRC(13) => 9223372036854775947
  rule KRC(14) => 9223372036854808713
  rule KRC(15) => 9223372036854808579
  rule KRC(16) => 9223372036854808578
  rule KRC(17) => 9223372036854775936
  rule KRC(18) => 32778
  rule KRC(19) => 9223372039002259466
  rule KRC(20) => 9223372039002292353
  rule KRC(21) => 9223372036854808704
  rule KRC(22) => 2147483649
  rule KRC(23) => 9223372039002292232

  // ---------------------------------------------------------------------
  // Theta — column parities C[x], diffusion D[x], applied to all 25 lanes
  // ---------------------------------------------------------------------
  syntax Int ::= KC0 ( Int ) [function, total]
  rule KC0(S:Int)
    => KLaneT(S, 0) xorInt KLaneT(S, 5) xorInt KLaneT(S, 10) xorInt KLaneT(S, 15) xorInt KLaneT(S, 20)

  syntax Int ::= KC1 ( Int ) [function, total]
  rule KC1(S:Int)
    => KLaneT(S, 1) xorInt KLaneT(S, 6) xorInt KLaneT(S, 11) xorInt KLaneT(S, 16) xorInt KLaneT(S, 21)

  syntax Int ::= KC2 ( Int ) [function, total]
  rule KC2(S:Int)
    => KLaneT(S, 2) xorInt KLaneT(S, 7) xorInt KLaneT(S, 12) xorInt KLaneT(S, 17) xorInt KLaneT(S, 22)

  syntax Int ::= KC3 ( Int ) [function, total]
  rule KC3(S:Int)
    => KLaneT(S, 3) xorInt KLaneT(S, 8) xorInt KLaneT(S, 13) xorInt KLaneT(S, 18) xorInt KLaneT(S, 23)

  syntax Int ::= KC4 ( Int ) [function, total]
  rule KC4(S:Int)
    => KLaneT(S, 4) xorInt KLaneT(S, 9) xorInt KLaneT(S, 14) xorInt KLaneT(S, 19) xorInt KLaneT(S, 24)

  syntax Int ::= KD0 ( Int ) [function, total]
  rule KD0(S:Int)
    => KC4(S) xorInt KRotT( KC1(S), 1 )

  syntax Int ::= KD1 ( Int ) [function, total]
  rule KD1(S:Int)
    => KC0(S) xorInt KRotT( KC2(S), 1 )

  syntax Int ::= KD2 ( Int ) [function, total]
  rule KD2(S:Int)
    => KC1(S) xorInt KRotT( KC3(S), 1 )

  syntax Int ::= KD3 ( Int ) [function, total]
  rule KD3(S:Int)
    => KC2(S) xorInt KRotT( KC4(S), 1 )

  syntax Int ::= KD4 ( Int ) [function, total]
  rule KD4(S:Int)
    => KC3(S) xorInt KRotT( KC0(S), 1 )

  syntax Int ::= KThetaT ( Int ) [function, total]
  rule KThetaT(S:Int)
    => KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( S, 24, KLaneT(S, 24) xorInt KD4(S) ), 23, KLaneT(S, 23) xorInt KD3(S) ), 22, KLaneT(S, 22) xorInt KD2(S) ), 21, KLaneT(S, 21) xorInt KD1(S) ), 20, KLaneT(S, 20) xorInt KD0(S) ), 19, KLaneT(S, 19) xorInt KD4(S) ), 18, KLaneT(S, 18) xorInt KD3(S) ), 17, KLaneT(S, 17) xorInt KD2(S) ), 16, KLaneT(S, 16) xorInt KD1(S) ), 15, KLaneT(S, 15) xorInt KD0(S) ), 14, KLaneT(S, 14) xorInt KD4(S) ), 13, KLaneT(S, 13) xorInt KD3(S) ), 12, KLaneT(S, 12) xorInt KD2(S) ), 11, KLaneT(S, 11) xorInt KD1(S) ), 10, KLaneT(S, 10) xorInt KD0(S) ), 9, KLaneT(S, 9) xorInt KD4(S) ), 8, KLaneT(S, 8) xorInt KD3(S) ), 7, KLaneT(S, 7) xorInt KD2(S) ), 6, KLaneT(S, 6) xorInt KD1(S) ), 5, KLaneT(S, 5) xorInt KD0(S) ), 4, KLaneT(S, 4) xorInt KD4(S) ), 3, KLaneT(S, 3) xorInt KD3(S) ), 2, KLaneT(S, 2) xorInt KD2(S) ), 1, KLaneT(S, 1) xorInt KD1(S) ), 0, KLaneT(S, 0) xorInt KD0(S) )

  // ---------------------------------------------------------------------
  // Rho + Pi — fully unrolled (literal target shifts; the pi table is a
  // bijection so the 25 shifted lanes OR together without overlap)
  // ---------------------------------------------------------------------
  syntax Int ::= KRhoPiT ( Int ) [function, total]
  rule KRhoPiT(S:Int)
    => ( KRotT( KLaneT(S, 0), 0 ) <<Int 0 ) |Int
       ( KRotT( KLaneT(S, 6), 44 ) <<Int 64 ) |Int
       ( KRotT( KLaneT(S, 12), 43 ) <<Int 128 ) |Int
       ( KRotT( KLaneT(S, 18), 21 ) <<Int 192 ) |Int
       ( KRotT( KLaneT(S, 24), 14 ) <<Int 256 ) |Int
       ( KRotT( KLaneT(S, 3), 28 ) <<Int 320 ) |Int
       ( KRotT( KLaneT(S, 9), 20 ) <<Int 384 ) |Int
       ( KRotT( KLaneT(S, 10), 3 ) <<Int 448 ) |Int
       ( KRotT( KLaneT(S, 16), 45 ) <<Int 512 ) |Int
       ( KRotT( KLaneT(S, 22), 61 ) <<Int 576 ) |Int
       ( KRotT( KLaneT(S, 1), 1 ) <<Int 640 ) |Int
       ( KRotT( KLaneT(S, 7), 6 ) <<Int 704 ) |Int
       ( KRotT( KLaneT(S, 13), 25 ) <<Int 768 ) |Int
       ( KRotT( KLaneT(S, 19), 8 ) <<Int 832 ) |Int
       ( KRotT( KLaneT(S, 20), 18 ) <<Int 896 ) |Int
       ( KRotT( KLaneT(S, 4), 27 ) <<Int 960 ) |Int
       ( KRotT( KLaneT(S, 5), 36 ) <<Int 1024 ) |Int
       ( KRotT( KLaneT(S, 11), 10 ) <<Int 1088 ) |Int
       ( KRotT( KLaneT(S, 17), 15 ) <<Int 1152 ) |Int
       ( KRotT( KLaneT(S, 23), 56 ) <<Int 1216 ) |Int
       ( KRotT( KLaneT(S, 2), 62 ) <<Int 1280 ) |Int
       ( KRotT( KLaneT(S, 8), 55 ) <<Int 1344 ) |Int
       ( KRotT( KLaneT(S, 14), 39 ) <<Int 1408 ) |Int
       ( KRotT( KLaneT(S, 15), 41 ) <<Int 1472 ) |Int
       ( KRotT( KLaneT(S, 21), 2 ) <<Int 1536 )

  // ---------------------------------------------------------------------
  // Chi — A'[x,y] = B[x,y] ^ ( ~B[x+1,y] & B[x+2,y] ), fully unrolled
  // ---------------------------------------------------------------------
  syntax Int ::= KChiT ( Int ) [function, total]
  rule KChiT(B:Int)
    => KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( B, 24, KLaneT(B, 24) xorInt ( KNot64T( KLaneT(B, 20) ) &Int KLaneT(B, 21) ) ), 23, KLaneT(B, 23) xorInt ( KNot64T( KLaneT(B, 24) ) &Int KLaneT(B, 20) ) ), 22, KLaneT(B, 22) xorInt ( KNot64T( KLaneT(B, 23) ) &Int KLaneT(B, 24) ) ), 21, KLaneT(B, 21) xorInt ( KNot64T( KLaneT(B, 22) ) &Int KLaneT(B, 23) ) ), 20, KLaneT(B, 20) xorInt ( KNot64T( KLaneT(B, 21) ) &Int KLaneT(B, 22) ) ), 19, KLaneT(B, 19) xorInt ( KNot64T( KLaneT(B, 15) ) &Int KLaneT(B, 16) ) ), 18, KLaneT(B, 18) xorInt ( KNot64T( KLaneT(B, 19) ) &Int KLaneT(B, 15) ) ), 17, KLaneT(B, 17) xorInt ( KNot64T( KLaneT(B, 18) ) &Int KLaneT(B, 19) ) ), 16, KLaneT(B, 16) xorInt ( KNot64T( KLaneT(B, 17) ) &Int KLaneT(B, 18) ) ), 15, KLaneT(B, 15) xorInt ( KNot64T( KLaneT(B, 16) ) &Int KLaneT(B, 17) ) ), 14, KLaneT(B, 14) xorInt ( KNot64T( KLaneT(B, 10) ) &Int KLaneT(B, 11) ) ), 13, KLaneT(B, 13) xorInt ( KNot64T( KLaneT(B, 14) ) &Int KLaneT(B, 10) ) ), 12, KLaneT(B, 12) xorInt ( KNot64T( KLaneT(B, 13) ) &Int KLaneT(B, 14) ) ), 11, KLaneT(B, 11) xorInt ( KNot64T( KLaneT(B, 12) ) &Int KLaneT(B, 13) ) ), 10, KLaneT(B, 10) xorInt ( KNot64T( KLaneT(B, 11) ) &Int KLaneT(B, 12) ) ), 9, KLaneT(B, 9) xorInt ( KNot64T( KLaneT(B, 5) ) &Int KLaneT(B, 6) ) ), 8, KLaneT(B, 8) xorInt ( KNot64T( KLaneT(B, 9) ) &Int KLaneT(B, 5) ) ), 7, KLaneT(B, 7) xorInt ( KNot64T( KLaneT(B, 8) ) &Int KLaneT(B, 9) ) ), 6, KLaneT(B, 6) xorInt ( KNot64T( KLaneT(B, 7) ) &Int KLaneT(B, 8) ) ), 5, KLaneT(B, 5) xorInt ( KNot64T( KLaneT(B, 6) ) &Int KLaneT(B, 7) ) ), 4, KLaneT(B, 4) xorInt ( KNot64T( KLaneT(B, 0) ) &Int KLaneT(B, 1) ) ), 3, KLaneT(B, 3) xorInt ( KNot64T( KLaneT(B, 4) ) &Int KLaneT(B, 0) ) ), 2, KLaneT(B, 2) xorInt ( KNot64T( KLaneT(B, 3) ) &Int KLaneT(B, 4) ) ), 1, KLaneT(B, 1) xorInt ( KNot64T( KLaneT(B, 2) ) &Int KLaneT(B, 3) ) ), 0, KLaneT(B, 0) xorInt ( KNot64T( KLaneT(B, 1) ) &Int KLaneT(B, 2) ) )

  // ---------------------------------------------------------------------
  // Iota + the round function + the 24-round permutation
  // ---------------------------------------------------------------------
  syntax Int ::= KIotaT ( Int , Int ) [function, total]
  rule KIotaT(S:Int, R:Int)
    => KSetLaneT( S, 0, KLaneT(S, 0) xorInt KRC(R) )

  syntax Int ::= KRoundT ( Int , Int ) [function, total]
  rule KRoundT(S:Int, R:Int) => KIotaT( KChiT( KRhoPiT( KThetaT(S) ) ), R )

  syntax Int ::= KeccakFT ( Int , Int ) [function, total]
  rule KeccakFT(S:Int, 24) => S
  rule KeccakFT(S:Int, R:Int) => KeccakFT( KRoundT(S, R), R +Int 1 )
    requires R >=Int 0 andBool R <Int 24

  // ---------------------------------------------------------------------
  // Padding (ORIGINAL Keccak: 0x01 ... 0x80; the KRYPTO.keccak256raw
  // convention).  The three rules partition lengthBytes(M) modInt 136
  // exactly: 0 (full pad block), 135 (single 0x81 byte), 1..134 interior.
  // FIX OF RECORD: the interior rule pads with KZeros(134 -Int Q) — the
  // padded block totals 136 bytes.
  // ---------------------------------------------------------------------
  syntax Bytes ::= KPad ( Bytes ) [function, total]
  rule KPad(M:Bytes) => KPadFrom(M, lengthBytes(M) modInt 136)

  syntax Bytes ::= KPadFrom ( Bytes , Int ) [function, total]
  rule KPadFrom(M:Bytes, 0) => M +Bytes KPadFullBlock()
  rule KPadFrom(M:Bytes, 135) => M +Bytes Int2Bytes(1, 129, BE)  // 0x81
  rule KPadFrom(M:Bytes, Q:Int)
    => M +Bytes Int2Bytes(1, 1, BE) +Bytes KZeros(134 -Int Q)
       +Bytes Int2Bytes(1, 128, BE)
    requires Q >Int 0 andBool Q <Int 135

  syntax Bytes ::= KPadFullBlock() [function, total]
  rule KPadFullBlock() => Int2Bytes(1, 1, BE) +Bytes KZeros(134)
                         +Bytes Int2Bytes(1, 128, BE)

  syntax Bytes ::= KZeros ( Int ) [function, total]
  rule KZeros(0) => .Bytes
  rule KZeros(N:Int) => Int2Bytes(1, 0, BE) +Bytes KZeros(N -Int 1)
    requires N >Int 0

  // ---------------------------------------------------------------------
  // Absorption: one 136-byte block XORed into the rate lanes 0..16 as a
  // PURE SetLane chain (each write targets a distinct literal lane, each
  // value reads the ORIGINAL state — no recursion, no double absorption).
  // The block reader's substrBytes bounds are literal and guarded by
  // lengthBytes(B) ==Int 136.
  // ---------------------------------------------------------------------
  syntax Int ::= KAbsorbBlockT ( Int , Bytes ) [function, total]
  rule KAbsorbBlockT(S:Int, B:Bytes)
    => KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( KSetLaneT( S, 0, KLaneT(S, 0) xorInt Bytes2Int( substrBytes(B, 0, 8), LE, Unsigned ) ), 1, KLaneT(S, 1) xorInt Bytes2Int( substrBytes(B, 8, 16), LE, Unsigned ) ), 2, KLaneT(S, 2) xorInt Bytes2Int( substrBytes(B, 16, 24), LE, Unsigned ) ), 3, KLaneT(S, 3) xorInt Bytes2Int( substrBytes(B, 24, 32), LE, Unsigned ) ), 4, KLaneT(S, 4) xorInt Bytes2Int( substrBytes(B, 32, 40), LE, Unsigned ) ), 5, KLaneT(S, 5) xorInt Bytes2Int( substrBytes(B, 40, 48), LE, Unsigned ) ), 6, KLaneT(S, 6) xorInt Bytes2Int( substrBytes(B, 48, 56), LE, Unsigned ) ), 7, KLaneT(S, 7) xorInt Bytes2Int( substrBytes(B, 56, 64), LE, Unsigned ) ), 8, KLaneT(S, 8) xorInt Bytes2Int( substrBytes(B, 64, 72), LE, Unsigned ) ), 9, KLaneT(S, 9) xorInt Bytes2Int( substrBytes(B, 72, 80), LE, Unsigned ) ), 10, KLaneT(S, 10) xorInt Bytes2Int( substrBytes(B, 80, 88), LE, Unsigned ) ), 11, KLaneT(S, 11) xorInt Bytes2Int( substrBytes(B, 88, 96), LE, Unsigned ) ), 12, KLaneT(S, 12) xorInt Bytes2Int( substrBytes(B, 96, 104), LE, Unsigned ) ), 13, KLaneT(S, 13) xorInt Bytes2Int( substrBytes(B, 104, 112), LE, Unsigned ) ), 14, KLaneT(S, 14) xorInt Bytes2Int( substrBytes(B, 112, 120), LE, Unsigned ) ), 15, KLaneT(S, 15) xorInt Bytes2Int( substrBytes(B, 120, 128), LE, Unsigned ) ), 16, KLaneT(S, 16) xorInt Bytes2Int( substrBytes(B, 128, 136), LE, Unsigned ) )
    requires lengthBytes(B) ==Int 136

  syntax Int ::= KLoadT ( Bytes , Int ) [function, total]
  rule KLoadT(B:Bytes, I:Int)
    => Bytes2Int( substrBytes(B, I *Int 8, I *Int 8 +Int 8), LE, Unsigned )

  // FIX OF RECORD: the remainder slice is substrBytes(B, 136,
  // lengthBytes(B)) (the -Int 136 form made the remainder EMPTY and
  // silently dropped every second block), and the == 136 base rule exists
  // because the LLVM Bytes hook substrBytes RAISES on start > end
  // (substrBytes(B, 136, 0) is an error, not the empty stream).
  syntax Int ::= KAbsorbAllT ( Int , Bytes ) [function, total]
  rule KAbsorbAllT(S:Int, B:Bytes) => S
    requires lengthBytes(B) ==Int 0
  rule KAbsorbAllT(S:Int, B:Bytes)
    => KeccakFT( KAbsorbBlockT(S, B), 0 )
    requires lengthBytes(B) ==Int 136
  rule KAbsorbAllT(S:Int, B:Bytes)
    => KAbsorbAllT( KeccakFT( KAbsorbBlockT(S, substrBytes(B, 0, 136)), 0 )
                  , substrBytes(B, 136, lengthBytes(B)) )
    requires lengthBytes(B) >Int 136

  // ---------------------------------------------------------------------
  // Squeeze: the 32-byte digest = lanes 0..3, little-endian
  // ---------------------------------------------------------------------
  syntax Bytes ::= KSqueezeT ( Int ) [function, total]
  rule KSqueezeT(S:Int)
    => Int2Bytes(8, KLaneT(S, 0), LE) +Bytes Int2Bytes(8, KLaneT(S, 1), LE)
       +Bytes Int2Bytes(8, KLaneT(S, 2), LE) +Bytes Int2Bytes(8, KLaneT(S, 3), LE)

  // ---------------------------------------------------------------------
  // THE TOTAL HASH — the leaf the M2 machine's builders call
  // ---------------------------------------------------------------------
  syntax Bytes ::= Keccak256T ( Bytes ) [function, total]
  rule Keccak256T(M:Bytes) => KSqueezeT( KAbsorbAllT( 0, KPad(M) ) )

endmodule
