// =============================================================================
// SRW3 PHASE 1M — THE WORKSTREAM-B PROOF LADDER (kb_proofs.k, hs)
//                    THE HASH-DEFINEDNESS BLOCKER (B1/B3), REMOVED AND
//                    MEASURED.
//
// One definition: the M2 hash-redirect machine (srw3closure-j-m2.k =
// the FROZEN 1J machine + the ONE L-FINDING-1 repair + the ONE hash-
// redirect equation) + the 1L proof-facing invariant definitions
// (j_invariant_m2.k — UNCHANGED definitions, M2 machine underneath).
//
// THE B1 BOUNDARY (phase1l/audit/induction-diagnosis.md): on the frozen
// machine the Haskell backend has NO evaluator for the KRYPTO
// Keccak256raw hook, so every proof path materializing
// #Ceil(Keccak256raw(...)) over symbolic or hash-containing arguments
// died.  M2 redirects the hash primitive to Keccak256T — a REAL,
// DETERMINISTIC, TOTAL evaluator in plain K rules (generated by
// scripts/gen_keccak_total_packed.py; 7/7 pinned vectors on BOTH
// backends; the M2 LLVM anchor is byte-identical to the frozen record
// 295e0b6d...).  This ladder MEASURES the removal:
//
//   §KB0  the evaluator claims: the vector PINNING in the proof backend
//         (destination-pinned literals — non-vacuous: a wrong evaluator
//         FAILS the unification), the B1 probe shapes over symbolic and
//         nested-hash arguments (the exact 1L probe texts), and the
//         REQUIRED negative controls (totality must grant NO hash
//         equality / NO injectivity — if either control PROVES, the
//         evaluator leaked an equality axiom and the gate FAILS);
//   §KB1  the 1L/M1 blocked claims RE-ATTEMPTED verbatim over M2
//         (KB-*): the B3 pool-Ceil class (exec/gate mint-into-set) and
//         the B1 hash-class destination materializations (init base —
//         including the HEAD-ADVANCE variant the 1L claim had to omit).
//         These are ATTEMPT claims: whichever way they resolve, the raw
//         result is recorded and the residual (if any) names the next
//         boundary — a FAILED re-attempt with a NON-Ceil residual is a
//         documented boundary, not a regression.
//   (the fresh OLD witness lives in kb_old_proofs.k over the M1 machine:
//    the same B1 probe shape WITHOUT the redirect — EXPECTED FAIL with
//    the #Ceil residual, pairing with KB-CEIL-SYMBOLIC.)
//
// LABEL DISCIPLINE (the frozen convention): PROVED / FAILED / BLOCKED /
// DEMONSTRATED / ASSUMED / NOT MECHANIZED; raw exit codes are never
// relabeled; Level III only; no consensus-integration claim.
// =============================================================================

requires "../semantics/j_invariant_m2.k"

module KB-PROOFS
  imports SRW3L-INVARIANT-M2

  // ===========================================================================
  // §KB0. THE EVALUATOR CLAIMS (the redirect measured at the proof level)
  // ===========================================================================

  claim // KB-VEC-ABC: THE VECTOR PIN IN THE PROOF BACKEND.  The source
        // materializes LinH over the literal "abc"; the destination is the
        // PINNED digest literal.  The proof closes iff the machine's hash
        // (through the redirect, evaluated INSIDE kprove on the Haskell
        // backend) computes exactly the pinned bytes; a wrong evaluator
        // fails the unification and the claim (non-vacuous: both sides are
        // ground).  want: c5d24601... is the EMPTY vector; this is "abc":
        // 4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45.
    <jhead> LinH(b"\x61\x62\x63")
         => b"\x4e\x03\x65\x7a\xea\x45\xa9\x4f\xc7\xd4\x7b\xa8\x26\xc8\xd6\x67\xc0\xd1\xe6\xe3\x3a\x64\xa0\x36\xec\x44\xf5\x8f\xa1\x2d\x6c\x45" </jhead>
    [label(KB-VEC-ABC)]

  claim // KB-VEC-TWOBLOCK: the TWO-BLOCK vector pin (215-byte message = 2
        // absorption blocks — exercises KAbsorbAllT's recursion slice, the
        // exact defect class the first build had) in the proof backend.
    <jhead> LinH(b"The quick brown fox jumps over the lazy dogThe quick brown fox jumps over the lazy dogThe quick brown fox jumps over the lazy dogThe quick brown fox jumps over the lazy dogThe quick brown fox jumps over the lazy dog")
         => b"\x2b\xca\x46\x57\x90\xfb\xe9\x52\xf1\xe3\x76\x8e\x10\x35\x7f\xe4\x39\xdf\x1a\x12\x53\xd3\xdb\xfa\xf2\xa2\xa5\x83\x91\x1c\x68\xd8" </jhead>
    [label(KB-VEC-TWOBLOCK)]

  claim // KB-EXP-NO-RULE-STUCK: MECHANICS EXPERIMENT — EXPECTED FAIL.  The
        // bare 1L B1 probe shape ("<jhead> H:Bytes => LinH(H:Bytes)
        // </jhead>", diagnosis §2 B1) has NO bearing rule: no machine rule
        // rewrites <jhead> alone, so the prover cannot rewrite and the
        // claim is stuck-SHAPED on ANY machine (the 1L probe's residual
        // arose from the implication check's Ceil side-condition, which the
        // RULE-BEARING claims exercise properly).  Retained as the
        // mechanics experiment; the B1 OLD/NEW pair is carried by
        // KB-OLD-INIT-BASE-HEAD (M1, EXPECTED FAIL with the #Ceil
        // residual — the 1L frozen-machine residual of record is verbatim
        // #Ceil(Keccak256raw(b"SRW3/ProtoCfg/R3" ...)) in the retained
        // kprove_L-INV-INIT-BASE.log) vs KB-INIT-BASE-HEAD (M2).
    <jhead> H:Bytes => LinH(H:Bytes) </jhead>
    [label(KB-EXP-NO-RULE-STUCK)]

  claim // KB-EXP-NESTED-STUCK: MECHANICS EXPERIMENT — EXPECTED FAIL (same
        // bearing-rule structure as KB-EXP-NO-RULE-STUCK, with the nested
        // hash in the destination: a hash application whose argument
        // CONTAINS a hash application — the diagnosis's "hash-containing
        // preimage" class).  The nested-materialization capacity that
        // MATTERS is exercised by the rule-bearing claims (the receipt
        // builders embed hash-of-canon fields; the digest pins exercise
        // multi-block evaluation).
    <jhead> H:Bytes => LinH( b"\x00" +Bytes LinH(H:Bytes) ) </jhead>
    [label(KB-EXP-NESTED-STUCK)]

  claim // KB-NEG-INJ: NEGATIVE CONTROL — MUST FAIL.  No rule changes
        // <jhead>, so the claim closes iff the requires is UNSATISFIABLE:
        // unsatisfiability would require deriving X ==K Y from
        // LinH(X) ==K LinH(Y) (injectivity) — totality of the evaluator
        // grants NO such power and NO collision resistance is assumed.
        // If this PROVES, the evaluator (or its encoding) leaked an
        // equality axiom — a GATE ALARM.
    <jhead> X:Bytes => Y:Bytes </jhead>
    requires LinH(X:Bytes) ==K LinH(Y:Bytes)
         andBool X:Bytes =/=K Y:Bytes
    [label(KB-NEG-INJ)]

  claim // KB-NEG-WEAKSAFEJ: NEGATIVE CONTROL — MUST FAIL (the handoff §3
        // third required control: "the weakened-safety invariant control
        // must continue to fail if the proof is supposed to depend on the
        // actual safety predicate").  L-NEG-CONTROL-SAFEJ (1L ladder)
        // re-run VERBATIM over M2: the accept step with the SafeJ guard
        // conjunct DELIBERATELY REMOVED from the requires, while the
        // DESTINATION is an unconstrained post-state XPost asserted safe.
        // Without the guard conjunct NOTHING ties the machine-installed
        // post-state to a SafeJ-satisfying XPost.  If this PROVES, the
        // accept-step lemma is vacuous — a GATE ALARM.
    <k> pCommitJ(B:JBlockJ, ERC:Bytes, ERP:Bytes, CV:Int) => .K </k>
    <janchor> A:Bytes => A:Bytes </janchor>
    <jstate> S:Map => XPost:Map </jstate>
    <jlineage> ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -2:Int |-> SetItem(R:JGateReceipt) RS:Set )
               ( -4:Int |-> SetItem(jgExecOf(R:JGateReceipt)) ES:Set )
               L3:Map
            => ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -2:Int |-> RS:Set )
               ( -4:Int |-> ES:Set )
               ( L3[jbSlotOf(B:JBlockJ) <- B:JBlockJ] ) </jlineage>
    <jnext> N:Int => N +Int 1 </jnext>
    <jhead> H:Bytes => JBlockCommitJ(B:JBlockJ, C:ProtoCfgR3) </jhead>
    <jlinhead> LH:Bytes => JRecChildF(jgRGOf(R:JGateReceipt)) </jlinhead>
    <jrefuse> RF:JRefuse </jrefuse>
    <jvalid> V:Bool => V:Bool </jvalid>
    requires jgBlockOf(R:JGateReceipt) ==K B:JBlockJ
         andBool jgErcOf(R:JGateReceipt) ==K ERC:Bytes
         andBool jgErpOf(R:JGateReceipt) ==K ERP:Bytes
         andBool jgHeadOf(R:JGateReceipt) ==K H:Bytes
         andBool jgSlotOf(R:JGateReceipt) ==Int N:Int
         andBool jgLinHeadOf(R:JGateReceipt) ==K LH:Bytes
         andBool CfgEqR3(jgCfgOf(R:JGateReceipt), C:ProtoCfgR3)
         andBool BytesEq(jgAnchorOf(R:JGateReceipt), A:Bytes)
         andBool jgDecisionOf(R:JGateReceipt) ==Int pdecValidJ
         andBool jbDecisionOf(B:JBlockJ) ==Int pdecValidJ
         andBool ExecValidPJ(B:JBlockJ, ERC:Bytes, ERP:Bytes)
         andBool BytesEq(linAzCertDOf(jgRGOf(R:JGateReceipt)),
                         jbEvidenceIdOf(B:JBlockJ))
         andBool GateInputMatchesBlockJ(jgFCOf(R:JGateReceipt),
                                        jgRGOf(R:JGateReceipt),
                                        jgCERTOf(R:JGateReceipt), B:JBlockJ)
         andBool ExecReceiptMatchesBlockJ(jgExecOf(R:JGateReceipt), B:JBlockJ)
         andBool ExecReceiptMatchesRecordJ(jgExecOf(R:JGateReceipt),
                                           jgRGOf(R:JGateReceipt))
         andBool BytesEq(jerHeadOf(jgExecOf(R:JGateReceipt)), H:Bytes)
         andBool jerSlotOf(jgExecOf(R:JGateReceipt)) ==Int N:Int
         andBool BytesEq(jerLinHeadOf(jgExecOf(R:JGateReceipt)), LH:Bytes)
         andBool BytesEq(jerAnchorOf(jgExecOf(R:JGateReceipt)), A:Bytes)
         andBool GateCtxAuthorizedJ(jgACOf(R:JGateReceipt), C:ProtoCfgR3,
                                    jbParentRootOf(B:JBlockJ))
         andBool GateAuthorityMatchesCfgJ(jgFCOf(R:JGateReceipt),
                                          C:ProtoCfgR3)
         andBool BytesEq(jbParentCommitOf(B:JBlockJ), H:Bytes)
         andBool jbSlotOf(B:JBlockJ) ==Int N:Int
         andBool CV:Int ==Int qcrPolicyVOf(C:ProtoCfgR3)
         andBool JFootprintRegistered(
                     JFootprintKeysOf(jerTraceOf(jgExecOf(R:JGateReceipt))),
                     jcResourcesOf(PCAT:JCatalog))
         andBool isJClosureOk(
                     AffectedClosureJ(
                         JFootprintKeysOf(jerTraceOf(jgExecOf(R:JGateReceipt))),
                         jcHypersOf(PCAT:JCatalog), JClosureFuelJ))
         andBool BytesEq(jgRootOf(R:JGateReceipt), ProtoRootR3(C:ProtoCfgR3))
         andBool BytesEq(jgCatRootOf(R:JGateReceipt),
                         JCatalogRootJ(PCAT:JCatalog))
         // the SafeJ guard conjunct is DELIBERATELY ABSENT; the claim
         // asserts the (unconstrained) destination post-state is safe
         // anyway — it must NOT prove:
         andBool SafeJ(PCAT:JCatalog, XPost:Map) ==K true
    [label(KB-NEG-WEAKSAFEJ)]

  // ===========================================================================
  // §KB1. THE 1L BLOCKED CLAIMS, RE-ATTEMPTED VERBATIM OVER M2 (ATTEMPT
  //       claims — the raw result is recorded, never relabeled)
  // ===========================================================================

  claim // KB-INIT-BASE: L-INV-INIT-BASE VERBATIM (1L ladder; FAILED there
        // with the B1 Ceil residual).  The destination is the exact pinned
        // post-state; every JInvJ conjunct is either a destination-pattern
        // fact or an init-guard conjunct.
    <k> pInitJ(C:ProtoCfgR3, P:JCatalog) => .K </k>
    <jlineage> .Map
            => ( -1:Int |-> C:ProtoCfgR3 ) ( -3:Int |-> P:JCatalog ) </jlineage>
    <jnext> N:Int </jnext>
    <janchor> A:Bytes </janchor>
    <jstate> .Map </jstate>
    <jrefuse> RF:JRefuse </jrefuse>
    <jvalid> V:Bool </jvalid>
    requires BytesEq(ProtoRootR3(C:ProtoCfgR3), A:Bytes)
         andBool JCatalogWF(P:JCatalog)
         andBool BytesEq(JAppSetRootJ(P:JCatalog), qcrAppSetDOf(C:ProtoCfgR3))
         andBool BytesEq(JGraphRootJ(P:JCatalog), qcrGraphDOf(C:ProtoCfgR3))
         andBool BytesEq(JPolicyRootJ(P:JCatalog), qcrPolicyDOf(C:ProtoCfgR3))
         andBool jcPolicyVOf(P:JCatalog) ==Int qcrPolicyVOf(C:ProtoCfgR3)
         andBool SafeJ(P:JCatalog, .Map) ==K true
    [label(KB-INIT-BASE)]

  claim // KB-INIT-BASE-HEAD: THE B1 MACHINE-LEVEL TEST — the 1L claim could
        // NOT carry the head advance ("the <jhead>/<jlinhead> advance (to
        // ProtoRootR3(C) / JLinRoot) is deliberately NOT part of this
        // claim: the symbolic head value is a hash-class term whose
        // destination materialization is BLOCKED" — 1L l_proofs.k).  Over
        // M2 the head advance is carried: the destination materializes
        // ProtoRootR3(C) = LinH(ProtoCfgCanonR3(C)) over a SYMBOLIC
        // configuration — the exact B1 class.  EXPECTED: PROVED iff the
        // redirect removed the machine-level B1 boundary.
    <k> pInitJ(C:ProtoCfgR3, P:JCatalog) => .K </k>
    <jhead> _:Bytes => ProtoRootR3(C:ProtoCfgR3) </jhead>
    <jlinhead> _:Bytes => JLinRoot </jlinhead>
    <jlineage> .Map
            => ( -1:Int |-> C:ProtoCfgR3 ) ( -3:Int |-> P:JCatalog ) </jlineage>
    <jnext> N:Int </jnext>
    <janchor> A:Bytes </janchor>
    <jstate> .Map </jstate>
    <jrefuse> RF:JRefuse </jrefuse>
    <jvalid> V:Bool </jvalid>
    requires BytesEq(ProtoRootR3(C:ProtoCfgR3), A:Bytes)
         andBool JCatalogWF(P:JCatalog)
         andBool BytesEq(JAppSetRootJ(P:JCatalog), qcrAppSetDOf(C:ProtoCfgR3))
         andBool BytesEq(JGraphRootJ(P:JCatalog), qcrGraphDOf(C:ProtoCfgR3))
         andBool BytesEq(JPolicyRootJ(P:JCatalog), qcrPolicyDOf(C:ProtoCfgR3))
         andBool jcPolicyVOf(P:JCatalog) ==Int qcrPolicyVOf(C:ProtoCfgR3)
         andBool SafeJ(P:JCatalog, .Map) ==K true
    [label(KB-INIT-BASE-HEAD)]

  claim // KB-EXEC-OK-STEP-POOL: L-INV-EXEC-OK-STEP-POOL VERBATIM (the B3
        // pool-Ceil class: building JExecReceiptOf(...) with hash-computed
        // fields into a SET over symbolic arguments).  EXPECTED: the
        // redirect removes the Ceil; whatever residual remains is
        // documented (a non-Ceil residual is a DIFFERENT boundary).
    <k> pExecJ(SRC:Bytes, PG:List, CL:Bytes, VL:Int) => .K </k>
    <jstate> S:Map </jstate>
    <jlineage> ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -4:Int |-> ES:Set ) L4:Map
            => ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -4:Int |-> SetItem(JExecReceiptOf(
                     SRC, PG, CL, VL, S, C, PCAT, A, H, N, LH,
                     jExecOkPostOf(ExecFragmentJ(S, PG)),
                     jExecOkEffOf(ExecFragmentJ(S, PG)),
                     jExecOkTraceOf(ExecFragmentJ(S, PG)))) ES )
               L4:Map </jlineage>
    <jnext> N:Int </jnext>
    <jhead> H:Bytes </jhead>
    <jlinhead> LH:Bytes </jlinhead>
    <janchor> A:Bytes </janchor>
    requires isExecOkJ(ExecFragmentJ(S:Map, PG:List))
         andBool BytesEq(SRC:Bytes, qcrExecClientDOf(C:ProtoCfgR3))
    [label(KB-EXEC-OK-STEP-POOL)]

  claim // KB-EXEC-OK-STEP-FRESH: L-INV-EXEC-OK-STEP-FRESH VERBATIM (the
        // first-mint B3 variant).
    <k> pExecJ(SRC:Bytes, PG:List, CL:Bytes, VL:Int) => .K </k>
    <jstate> S:Map </jstate>
    <jlineage> ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog ) L2:Map
            => ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -4:Int |-> SetItem(JExecReceiptOf(
                     SRC, PG, CL, VL, S, C, PCAT, A, H, N, LH,
                     jExecOkPostOf(ExecFragmentJ(S, PG)),
                     jExecOkEffOf(ExecFragmentJ(S, PG)),
                     jExecOkTraceOf(ExecFragmentJ(S, PG)))) .Set )
               L2:Map </jlineage>
    <jnext> N:Int </jnext>
    <jhead> H:Bytes </jhead>
    <jlinhead> LH:Bytes </jlinhead>
    <janchor> A:Bytes </janchor>
    requires notBool ( -4:Int in_keys(L2:Map) )
         andBool isExecOkJ(ExecFragmentJ(S:Map, PG:List))
         andBool BytesEq(SRC:Bytes, qcrExecClientDOf(C:ProtoCfgR3))
    [label(KB-EXEC-OK-STEP-FRESH)]

  claim // KB-GATE-STEP-POOL: L-INV-GATE-STEP-POOL VERBATIM (the gate mint
        // into the -2 pool: the receipt carries the COMPUTED verdict
        // VerifyLineageG(...) and the machine-computed roots — the B3/B1
        // combination; 1L run timed out rc=124 — the runner keeps a
        // bounded budget and records the outcome either way).
    <k> pGateEvalJ(B:JBlockJ, FC:ExecCtx, RG:LinRecG, CERT:AuthzCert,
                   ERC:Bytes, ERP:Bytes) => .K </k>
    <jnext> N:Int </jnext>
    <jhead> H:Bytes </jhead>
    <jlinhead> LH:Bytes </jlinhead>
    <janchor> A:Bytes </janchor>
    <jlineage> ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -2:Int |-> PS:Set )
               ( -4:Int |-> SetItem(E:JExecReceipt) ES:Set ) L2:Map
            => ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -2:Int |-> SetItem(
                     jGateReceipt( B:JBlockJ, ERC:Bytes, ERP:Bytes
                                 , FC:ExecCtx, RG:LinRecG, CERT:AuthzCert
                                 , azCtx( FC:ExecCtx
                                        , ProtoAuthorizedSecCtxR3(C:ProtoCfgR3
                                            , jbParentRootOf(B:JBlockJ) )
                                        , CERT:AuthzCert
                                        , qcrAuthPTOf(C:ProtoCfgR3)
                                        , qcrAuthGuestDOf(C:ProtoCfgR3)
                                        , qcrAuthCfgDOf(C:ProtoCfgR3) )
                                 , E:JExecReceipt
                                 , VerifyLineageG(
                                       RG:LinRecG
                                     , azCtx( FC:ExecCtx
                                            , ProtoAuthorizedSecCtxR3(
                                                  C:ProtoCfgR3
                                                , jbParentRootOf(B:JBlockJ) )
                                            , CERT:AuthzCert
                                            , qcrAuthPTOf(C:ProtoCfgR3)
                                            , qcrAuthGuestDOf(C:ProtoCfgR3)
                                            , qcrAuthCfgDOf(C:ProtoCfgR3) )
                                       , N:Int, LH:Bytes )
                                 , H:Bytes, N:Int, LH:Bytes
                                 , C:ProtoCfgR3, ProtoRootR3(C:ProtoCfgR3)
                                 , A:Bytes
                                 , JCatalogRootJ(PCAT:JCatalog) )) PS:Set )
               ( -4:Int |-> SetItem(E:JExecReceipt) ES:Set ) L2:Map </jlineage>
    requires GateInputMatchesBlockJ(FC:ExecCtx, RG:LinRecG, CERT:AuthzCert,
                                    B:JBlockJ)
         andBool GateAuthorityMatchesCfgJ(FC:ExecCtx, C:ProtoCfgR3)
         andBool BytesEq(jbParentCommitOf(B:JBlockJ), H:Bytes)
         andBool jbSlotOf(B:JBlockJ) ==Int N:Int
         andBool ExecReceiptMatchesBlockJ(E:JExecReceipt, B:JBlockJ)
         andBool ExecReceiptMatchesRecordJ(E:JExecReceipt, RG:LinRecG)
         andBool BytesEq(jerHeadOf(E:JExecReceipt), H:Bytes)
         andBool jerSlotOf(E:JExecReceipt) ==Int N:Int
         andBool BytesEq(jerLinHeadOf(E:JExecReceipt), LH:Bytes)
         andBool BytesEq(jerAnchorOf(E:JExecReceipt), A:Bytes)
    [label(KB-GATE-STEP-POOL)]

  claim // KB-GATE-STEP-FRESH: L-INV-GATE-STEP-FRESH VERBATIM (the first
        // gate mint).
    <k> pGateEvalJ(B:JBlockJ, FC:ExecCtx, RG:LinRecG, CERT:AuthzCert,
                   ERC:Bytes, ERP:Bytes) => .K </k>
    <jnext> N:Int </jnext>
    <jhead> H:Bytes </jhead>
    <jlinhead> LH:Bytes </jlinhead>
    <janchor> A:Bytes </janchor>
    <jlineage> ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -4:Int |-> SetItem(E:JExecReceipt) ES:Set ) L2:Map
            => ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -2:Int |-> SetItem(
                     jGateReceipt( B:JBlockJ, ERC:Bytes, ERP:Bytes
                                 , FC:ExecCtx, RG:LinRecG, CERT:AuthzCert
                                 , azCtx( FC:ExecCtx
                                        , ProtoAuthorizedSecCtxR3(C:ProtoCfgR3
                                            , jbParentRootOf(B:JBlockJ) )
                                        , CERT:AuthzCert
                                        , qcrAuthPTOf(C:ProtoCfgR3)
                                        , qcrAuthGuestDOf(C:ProtoCfgR3)
                                        , qcrAuthCfgDOf(C:ProtoCfgR3) )
                                 , E:JExecReceipt
                                 , VerifyLineageG(
                                       RG:LinRecG
                                     , azCtx( FC:ExecCtx
                                            , ProtoAuthorizedSecCtxR3(
                                                  C:ProtoCfgR3
                                                , jbParentRootOf(B:JBlockJ) )
                                            , CERT:AuthzCert
                                            , qcrAuthPTOf(C:ProtoCfgR3)
                                            , qcrAuthGuestDOf(C:ProtoCfgR3)
                                            , qcrAuthCfgDOf(C:ProtoCfgR3) )
                                       , N:Int, LH:Bytes )
                                 , H:Bytes, N:Int, LH:Bytes
                                 , C:ProtoCfgR3, ProtoRootR3(C:ProtoCfgR3)
                                 , A:Bytes
                                 , JCatalogRootJ(PCAT:JCatalog) )) .Set )
               ( -4:Int |-> SetItem(E:JExecReceipt) ES:Set ) L2:Map </jlineage>
    requires notBool ( -2:Int in_keys(L2:Map) )
         andBool GateInputMatchesBlockJ(FC:ExecCtx, RG:LinRecG, CERT:AuthzCert,
                                        B:JBlockJ)
         andBool GateAuthorityMatchesCfgJ(FC:ExecCtx, C:ProtoCfgR3)
         andBool BytesEq(jbParentCommitOf(B:JBlockJ), H:Bytes)
         andBool jbSlotOf(B:JBlockJ) ==Int N:Int
         andBool ExecReceiptMatchesBlockJ(E:JExecReceipt, B:JBlockJ)
         andBool ExecReceiptMatchesRecordJ(E:JExecReceipt, RG:LinRecG)
         andBool BytesEq(jerHeadOf(E:JExecReceipt), H:Bytes)
         andBool jerSlotOf(E:JExecReceipt) ==Int N:Int
         andBool BytesEq(jerLinHeadOf(E:JExecReceipt), LH:Bytes)
         andBool BytesEq(jerAnchorOf(E:JExecReceipt), A:Bytes)
    [label(KB-GATE-STEP-FRESH)]

  claim // KB-COMMIT-ACCEPT-POSTSTATE: L-INV-COMMIT-ACCEPT-POSTSTATE
        // VERBATIM — THE KEY STEP.  An accepted commit installs EXACTLY
        // the derived post-state the guard certified; SafeJ appears ONLY
        // in the guard (computed), never as an independent hypothesis.
    <k> pCommitJ(B:JBlockJ, ERC:Bytes, ERP:Bytes, CV:Int) => .K </k>
    <janchor> A:Bytes => A:Bytes </janchor>
    <jstate> S:Map => jerPostOf(jgExecOf(R:JGateReceipt)) </jstate>
    <jlineage> ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -2:Int |-> SetItem(R:JGateReceipt) RS:Set )
               ( -4:Int |-> SetItem(jgExecOf(R:JGateReceipt)) ES:Set )
               L3:Map
            => ( -1:Int |-> C:ProtoCfgR3 )
               ( -3:Int |-> PCAT:JCatalog )
               ( -2:Int |-> RS:Set )
               ( -4:Int |-> ES:Set )
               ( L3[jbSlotOf(B:JBlockJ) <- B:JBlockJ] ) </jlineage>
    <jnext> N:Int => N +Int 1 </jnext>
    <jhead> H:Bytes => JBlockCommitJ(B:JBlockJ, C:ProtoCfgR3) </jhead>
    <jlinhead> LH:Bytes => JRecChildF(jgRGOf(R:JGateReceipt)) </jlinhead>
    <jrefuse> RF:JRefuse </jrefuse>
    <jvalid> V:Bool => V:Bool </jvalid>
    requires jgBlockOf(R:JGateReceipt) ==K B:JBlockJ
         andBool jgErcOf(R:JGateReceipt) ==K ERC:Bytes
         andBool jgErpOf(R:JGateReceipt) ==K ERP:Bytes
         andBool jgHeadOf(R:JGateReceipt) ==K H:Bytes
         andBool jgSlotOf(R:JGateReceipt) ==Int N:Int
         andBool jgLinHeadOf(R:JGateReceipt) ==K LH:Bytes
         andBool CfgEqR3(jgCfgOf(R:JGateReceipt), C:ProtoCfgR3)
         andBool BytesEq(jgAnchorOf(R:JGateReceipt), A:Bytes)
         andBool jgDecisionOf(R:JGateReceipt) ==Int pdecValidJ
         andBool jbDecisionOf(B:JBlockJ) ==Int pdecValidJ
         andBool ExecValidPJ(B:JBlockJ, ERC:Bytes, ERP:Bytes)
         andBool BytesEq(linAzCertDOf(jgRGOf(R:JGateReceipt)),
                         jbEvidenceIdOf(B:JBlockJ))
         andBool GateInputMatchesBlockJ(jgFCOf(R:JGateReceipt),
                                        jgRGOf(R:JGateReceipt),
                                        jgCERTOf(R:JGateReceipt), B:JBlockJ)
         andBool ExecReceiptMatchesBlockJ(jgExecOf(R:JGateReceipt), B:JBlockJ)
         andBool ExecReceiptMatchesRecordJ(jgExecOf(R:JGateReceipt),
                                           jgRGOf(R:JGateReceipt))
         andBool BytesEq(jerHeadOf(jgExecOf(R:JGateReceipt)), H:Bytes)
         andBool jerSlotOf(jgExecOf(R:JGateReceipt)) ==Int N:Int
         andBool BytesEq(jerLinHeadOf(jgExecOf(R:JGateReceipt)), LH:Bytes)
         andBool BytesEq(jerAnchorOf(jgExecOf(R:JGateReceipt)), A:Bytes)
         andBool GateCtxAuthorizedJ(jgACOf(R:JGateReceipt), C:ProtoCfgR3,
                                    jbParentRootOf(B:JBlockJ))
         andBool GateAuthorityMatchesCfgJ(jgFCOf(R:JGateReceipt),
                                          C:ProtoCfgR3)
         andBool BytesEq(jbParentCommitOf(B:JBlockJ), H:Bytes)
         andBool jbSlotOf(B:JBlockJ) ==Int N:Int
         andBool CV:Int ==Int qcrPolicyVOf(C:ProtoCfgR3)
         andBool JFootprintRegistered(
                     JFootprintKeysOf(jerTraceOf(jgExecOf(R:JGateReceipt))),
                     jcResourcesOf(PCAT:JCatalog))
         andBool isJClosureOk(
                     AffectedClosureJ(
                         JFootprintKeysOf(jerTraceOf(jgExecOf(R:JGateReceipt))),
                         jcHypersOf(PCAT:JCatalog), JClosureFuelJ))
         andBool SafeJ(PCAT:JCatalog,
                       jerPostOf(jgExecOf(R:JGateReceipt))) ==K true
         andBool BytesEq(jgRootOf(R:JGateReceipt), ProtoRootR3(C:ProtoCfgR3))
         andBool BytesEq(jgCatRootOf(R:JGateReceipt),
                         JCatalogRootJ(PCAT:JCatalog))
    [label(KB-COMMIT-ACCEPT-POSTSTATE)]

endmodule
