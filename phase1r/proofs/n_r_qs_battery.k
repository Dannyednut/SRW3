// =============================================================================
// SRW3 PHASE 1R — THE QS EVIDENCE BATTERY (semantics preservation of the
//                    additive stall-row variant) (phase1r/proofs/n_r_qs_battery.k)
//
// The variant of record: SRW3N-ABS-QS = the frozen 1Q machine + the four
// explicit pre-init stall rows (edit set ER-1, generated by make_abs_qs.py).
// The transition relation is UNCHANGED (see the generator docstring); the
// claims here are the mechanical evidence:
//
//   1R-QS-STALL-STEP-Q     the stall identity at the runner: consuming a
//                          pre-init exec command leaves the shadow state
//                          unchanged (the owise's exact behavior, now
//                          explicit — MUST PROVE by one real step);
//   1R-QS-STALL-NONEXEC-Q  the domain discipline: a run whose head is a
//                          pre-init exec command is NOT executable
//                          (absExecutableQ evaluates false — MUST PROVE by
//                          evaluation; the reason the refined branch dies);
//   1R-QS-RUN-HONEST-Q     the 1Q honest pipeline ground execution, restated
//                          over QS (MUST PROVE by real rewriting — the same
//                          start/end as the 1Q claim of record);
//   1R-QS-RUN-INIT-EXEC-Q  the 1Q init-then-exec ground execution over QS;
//   1R-QS-EMPTY-REJECT-STEP-Q  the 1Q strong empty-commit reject step,
//                          re-run over QS (the step function is untouched —
//                          the regression anchor).
//
// Whatever the raw results, they are recorded and never relabeled.
// Level III only; no consensus-integration claim.
// =============================================================================

requires "../semantics/abs-machine-qs.k"

module R-QS-BATTERY-PROOFS
  imports SRW3N-ABS-QS

  claim // 1R-QS-STALL-STEP-Q: the explicit stall row's transition is the
        // identity on the shadow (one real rewrite through the added row).
    <srw3closureJ>
      <k> aExecJ(aOkT:AOk, aSrcAuth:ASrc) => .K ... </k>
      <absjshadow> absStQ(0, false, false, zeroP, zeroP, 0, false, adNone)
                => absStQ(0, false, false, zeroP, zeroP, 0, false, adNone) </absjshadow>
      ...
    </srw3closureJ>
    [label(1R-QS-STALL-STEP-Q)]

  claim // 1R-QS-STALL-NONEXEC-Q: the pre-init exec run is NOT executable
        // (the domain predicate's exec row returns false at tag 0).
    <k> ( absExecutableQ(aConsJ(aExecJ(aOkT:AOk, aSrcAuth:ASrc), aRunNilJ),
              absStQ(0, false, false, zeroP, zeroP, 0, false, adNone))
          ==K false ) => true </k>
    [label(1R-QS-STALL-NONEXEC-Q)]

  claim // 1R-QS-RUN-HONEST-Q: the 1Q honest pipeline over QS — the exact
        // 1Q-RUN-HONEST-Q start/end pair (the genesis to the post-commit
        // state; both pools zeroP; the slot counter advanced to 1).
    <srw3closureJ>
      <k> aConsJ(aInitJ(aOkT:AOk),aConsJ(aExecJ(aOkT:AOk,aSrcAuth:ASrc),aConsJ(aGateJ(aOkT:AOk),aConsJ(aCommitJ(aOkT:AOk,aOkT:AOk),aRunNilJ)))) => .K ... </k>
      <absjshadow> absGenesisQ => absStQ(1, true, true, zeroP, zeroP, 1, true, adNone):AStateQ </absjshadow>
      ...
    </srw3closureJ>
    [label(1R-QS-RUN-HONEST-Q)]

  claim // 1R-QS-RUN-INIT-EXEC-Q: the 1Q init-then-exec run over QS (the
        // mint makes the E pool succP(zeroP) — the exact count).
    <srw3closureJ>
      <k> aConsJ(aInitJ(aOkT:AOk),aConsJ(aExecJ(aOkT:AOk,aSrcAuth:ASrc),aRunNilJ)) => .K ... </k>
      <absjshadow> absGenesisQ => absStQ(1, true, true, zeroP, succP(zeroP), 0, true, adNone):AStateQ </absjshadow>
      ...
    </srw3closureJ>
    [label(1R-QS-RUN-INIT-EXEC-Q)]

  claim // 1R-QS-EMPTY-REJECT-STEP-Q: the 1Q strong empty-commit reject
        // step, re-run over QS (the step function untouched — the anchor).
    <k> absStepQ(absStQ(1, true, true, zeroP, zeroP, 0, true, adNone),
                 aCommitJ(aOkT:AOk, aOkT:AOk))
        => absStQ(1, true, true, zeroP, zeroP, 0, true, adNone) </k>
    [label(1R-QS-EMPTY-REJECT-STEP-Q)]

endmodule
